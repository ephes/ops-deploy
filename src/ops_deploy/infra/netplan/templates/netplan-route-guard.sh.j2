#!/usr/bin/env bash
# Managed by local.ops_library.netplan_config
set -euo pipefail

readonly LOCK_FILE={{ ('/run/' ~ netplan_config_route_guard_service_name ~ '/lock') | quote }}
readonly SYS_CLASS_NET=/sys/class/net
readonly CONFIRMATION_DELAY={{ netplan_config_route_guard_confirmation_delay_sec | int }}
readonly RECOVERY_DELAY={{ netplan_config_route_guard_recovery_delay_sec | int }}

install -d -m 0700 -o root -g root "$(dirname "${LOCK_FILE}")"
exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
    logger --tag {{ netplan_config_route_guard_service_name | quote }} \
        "another route guard invocation holds ${LOCK_FILE}; skipping"
    exit 0
fi

failed=0

setup_state() {
    local status_json
    if ! status_json="$(networkctl status --json=short "$1")"; then
        return 1
    fi
    python3 -c 'import json, sys; value = json.load(sys.stdin).get("AdministrativeState"); sys.exit(1) if not isinstance(value, str) or not value else print(value)' \
        <<<"${status_json}"
}

carrier_state() {
    local carrier operstate
    if ! carrier="$(cat "${SYS_CLASS_NET}/$1/carrier" 2>/dev/null)"; then
        if operstate="$(cat "${SYS_CLASS_NET}/$1/operstate" 2>/dev/null)"; then
            case "${operstate}" in
                down|dormant|lowerlayerdown|notpresent)
                    printf '0\n'
                    return 0
                    ;;
            esac
        fi
        return 1
    fi
    printf '%s\n' "${carrier}"
}

default_route_state() {
    local routes
    if ! routes="$(ip -4 route show default dev "$1")"; then
        printf '%s\n' probe-error
    elif [[ -n "${routes}" ]]; then
        printf '%s\n' present
    else
        printf '%s\n' missing
    fi
}

{% for interface in netplan_config_route_guard_interfaces %}
interface={{ interface | quote }}
if [[ ! -d "${SYS_CLASS_NET}/${interface}" ]]; then
    logger --tag {{ netplan_config_route_guard_service_name | quote }} \
        "configured interface ${interface} does not exist"
    failed=1
elif ! current_carrier_state="$(carrier_state "${interface}")"; then
    logger --tag {{ netplan_config_route_guard_service_name | quote }} \
        "carrier state is unreadable for ${interface}"
    failed=1
elif [[ "${current_carrier_state}" == "1" ]]; then
    if ! current_setup_state="$(setup_state "${interface}")"; then
        logger --tag {{ netplan_config_route_guard_service_name | quote }} \
            "unable to read networkd setup state for ${interface}"
        failed=1
        current_setup_state="probe-error"
    fi
    current_route_state="$(default_route_state "${interface}")"
    if [[ "${current_route_state}" == "probe-error" ]]; then
        logger --tag {{ netplan_config_route_guard_service_name | quote }} \
            "unable to read IPv4 routes for ${interface}"
        failed=1
    fi
    if [[ "${current_route_state}" == "missing" ]] && [[ "${current_setup_state}" != "failed" ]] && { [[ "${current_setup_state}" == "configured" ]] || [[ "${current_setup_state}" == "unmanaged" ]] || [[ "${current_setup_state}" == "linger" ]]; } && (( CONFIRMATION_DELAY > 0 )); then
        sleep "${CONFIRMATION_DELAY}"
        if ! current_setup_state="$(setup_state "${interface}")"; then
            current_setup_state="probe-error"
            failed=1
        fi
        current_route_state="$(default_route_state "${interface}")"
        if [[ "${current_route_state}" == "probe-error" ]]; then
            failed=1
        fi
    fi
    if [[ "${current_route_state}" == "missing" ]] && [[ "${current_setup_state}" != "configured" ]] && [[ "${current_setup_state}" != "failed" ]] && [[ "${current_setup_state}" != "unmanaged" ]] && [[ "${current_setup_state}" != "linger" ]] && [[ "${current_setup_state}" != "pending" ]] && [[ "${current_setup_state}" != "initialized" ]] && [[ "${current_setup_state}" != "configuring" ]]; then
        logger --tag {{ netplan_config_route_guard_service_name | quote }} \
            "unexpected networkd setup state for ${interface}: ${current_setup_state}"
        failed=1
    fi
    if [[ "${current_setup_state}" == "failed" ]] || { [[ "${current_route_state}" == "missing" ]] && { [[ "${current_setup_state}" == "configured" ]] || [[ "${current_setup_state}" == "unmanaged" ]] || [[ "${current_setup_state}" == "linger" ]]; }; }; then
        if ! recovery_carrier_state="$(carrier_state "${interface}")"; then
            logger --tag {{ netplan_config_route_guard_service_name | quote }} \
                "carrier state became unreadable for ${interface}; skipping recovery"
            failed=1
        elif [[ "${recovery_carrier_state}" != "1" ]]; then
            logger --tag {{ netplan_config_route_guard_service_name | quote }} \
                "carrier dropped for ${interface}; skipping recovery"
        else
            logger --tag {{ netplan_config_route_guard_service_name | quote }} \
                "recovering ${interface}: setup_state=${current_setup_state}, route_state=${current_route_state}"
            if ! networkctl reconfigure "${interface}"; then
                logger --tag {{ netplan_config_route_guard_service_name | quote }} \
                    "networkctl reconfigure failed for ${interface}"
                failed=1
            else
                if (( RECOVERY_DELAY > 0 )); then
                    sleep "${RECOVERY_DELAY}"
                fi
                if ! recovered_setup_state="$(setup_state "${interface}")"; then
                    recovered_setup_state="probe-error"
                fi
                recovered_route_state="$(default_route_state "${interface}")"
                if [[ "${recovered_route_state}" != "present" ]] || [[ "${recovered_setup_state}" != "configured" ]]; then
                    logger --tag {{ netplan_config_route_guard_service_name | quote }} \
                        "recovery incomplete for ${interface}: setup_state=${recovered_setup_state}, route_state=${recovered_route_state}"
                    failed=1
                else
                    logger --tag {{ netplan_config_route_guard_service_name | quote }} \
                        "recovered ${interface}: setup_state=${recovered_setup_state}"
                fi
            fi
        fi
    fi
else
    logger --tag {{ netplan_config_route_guard_service_name | quote }} \
        "carrier is absent for ${interface}; skipping route and networkd recovery probes"
fi
{% endfor %}

exit "${failed}"
