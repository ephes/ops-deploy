{% import "_edge.j2" as edge -%}
# Managed by Ansible (livekit_deploy). Do not edit on the host.

http:
  routers:
    livekit:
      rule: "Host(`{{ cfg.traefik_host }}`){% if cfg.traefik_internal_ip_ranges %} && ({% for range in cfg.traefik_internal_ip_ranges %}ClientIP(`{{ range }}`){{ ' || ' if not loop.last else '' }}{% endfor %}){% endif %}"
      entryPoints:
        - web-secure
      middlewares:
        - livekit-headers
      service: livekit
      tls: {}

  middlewares:
    livekit-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: https
          X-Forwarded-Host: "{{ cfg.traefik_host }}"
{{- edge.request_headers(10) }}

  services:
    livekit:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ cfg.http_port }}"
