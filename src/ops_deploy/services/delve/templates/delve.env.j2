# Managed by Ansible (delve_deploy). Do not edit on the host.
DELVE_ADDR="{{ cfg.listen_address }}:{{ cfg.port }}"
DELVE_DB_PATH="{{ cfg.data_dir }}/delve.db"
DELVE_PUBLIC_URL="{{ cfg.public_url }}"
DELVE_SESSION_SECRET="{{ secrets.session_secret }}"
{% if cfg.admin_emails -%}
DELVE_ADMIN_EMAILS="{{ cfg.admin_emails }}"
{% endif -%}
{% if secrets.get("dogfood_token") -%}
DELVE_DOGFOOD_TOKEN="{{ secrets.dogfood_token }}"
{% endif -%}
{% if cfg.apple_client_id -%}
DELVE_APPLE_CLIENT_ID="{{ cfg.apple_client_id }}"
{% endif -%}
{% for name, value in cfg.optional_flags -%}
{% if value is not none -%}
{{ name }}="{{ value | lower }}"
{% endif -%}
{% endfor -%}
{% if cfg.storekit_root_certs_path -%}
DELVE_STOREKIT_ROOT_CERTS="{{ cfg.storekit_root_certs_path }}"
DELVE_STOREKIT_BUNDLE_ID="{{ cfg.storekit_bundle_id }}"
DELVE_STOREKIT_PRODUCT_IDS="{{ cfg.storekit_product_ids }}"
{% endif -%}
DELVE_DISCOVERY_POLL_INTERVAL_SECONDS="{{ cfg.discovery_poll_interval_seconds }}"
DELVE_DISCOVERY_POLL_JITTER_SECONDS="{{ cfg.discovery_poll_jitter_seconds }}"
DELVE_DISCOVERY_EPISODE_TTL_SECONDS="{{ cfg.discovery_episode_ttl_seconds }}"
DELVE_DISCOVERY_MAX_ITEMS_PER_FEED="{{ cfg.discovery_max_items_per_feed }}"
DELVE_DISCOVERY_MAX_SOURCES_PER_RUN="{{ cfg.discovery_max_sources_per_run }}"
{% if cfg.env -%}
DELVE_ENV="{{ cfg.env }}"
{% endif -%}
{% if cfg.smart_skip_analysis -%}
DELVE_SMART_SKIP_ANALYSIS="true"
DELVE_SMART_SKIP_ANALYSIS_PROFILE="{{ cfg.profile_path }}"
{% if cfg.analysis_media_dir -%}
DELVE_ANALYSIS_MEDIA_DIR="{{ cfg.analysis_media_dir }}"
{% endif -%}
{% if cfg.analysis_media_disk_cap_bytes is not none -%}
DELVE_ANALYSIS_MEDIA_DISK_CAP_BYTES="{{ cfg.analysis_media_disk_cap_bytes }}"
{% endif -%}
{% if cfg.ffprobe_path -%}
DELVE_FFPROBE_PATH="{{ cfg.ffprobe_path }}"
{% endif -%}
{% if cfg.ffmpeg_path -%}
DELVE_FFMPEG_PATH="{{ cfg.ffmpeg_path }}"
{% endif -%}
{% if cfg.voxhelm_url -%}
DELVE_VOXHELM_URL="{{ cfg.voxhelm_url }}"
DELVE_VOXHELM_TOKEN_FILE="{{ cfg.voxhelm_token_file }}"
{% endif -%}
{% if cfg.voxhelm_timeout_seconds is not none -%}
DELVE_VOXHELM_TIMEOUT_SECONDS="{{ cfg.voxhelm_timeout_seconds }}"
{% endif -%}
{% if cfg.voxhelm_upload_timeout_seconds is not none -%}
DELVE_VOXHELM_UPLOAD_TIMEOUT_SECONDS="{{ cfg.voxhelm_upload_timeout_seconds }}"
{% endif -%}
{% if cfg.voxhelm_poll_seconds is not none -%}
DELVE_VOXHELM_POLL_SECONDS="{{ cfg.voxhelm_poll_seconds }}"
{% endif -%}
{% if cfg.detector_url -%}
DELVE_DETECTOR_URL="{{ cfg.detector_url }}"
DELVE_DETECTOR_API_KEY_FILE="{{ cfg.detector_api_key_file }}"
{% endif -%}
{% if cfg.detector_timeout_seconds is not none -%}
DELVE_DETECTOR_TIMEOUT_SECONDS="{{ cfg.detector_timeout_seconds }}"
{% endif -%}
{% endif -%}
