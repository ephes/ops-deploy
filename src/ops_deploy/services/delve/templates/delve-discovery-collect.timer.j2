# Managed by Ansible (delve_deploy). Do not edit on the host.
[Unit]
Description=Run Delve Discovery reviewed RSS collector

[Timer]
OnCalendar={{ cfg.discovery_collector_calendar }}
RandomizedDelaySec={{ cfg.discovery_collector_randomized_delay_sec }}
Persistent=true
Unit={{ cfg.collector_service_name }}.service

[Install]
WantedBy=timers.target
