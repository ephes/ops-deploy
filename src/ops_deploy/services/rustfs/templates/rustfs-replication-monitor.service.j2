{% set monitor = cfg.monitor %}
[Unit]
{% if monitor.role == "source" %}
Description=Write RustFS replication heartbeat objects
{% else %}
Description=Check RustFS replication lag and parity
{% endif %}
# At boot the Persistent= timer fires as soon as timers.target is up: wait for
# the first NTP sync (a skewed clock gets RequestTimeTooSkewed and wrong lag)
# and, in ExecStartPre=, for RustFS to answer, so a reboot leaves no failed run.
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target time-sync.target systemd-time-wait-sync.service rustfs.service

[Service]
Type=oneshot
{% if monitor.role == "source" %}
# Root on the local server (queue metrics, source counts, heartbeat writes).
EnvironmentFile={{ cfg.env_file }}
{% endif %}
EnvironmentFile={{ monitor.env_file }}
Environment=RUSTFS_MONITOR_LIBRARY={{ monitor.library_dir }}
{% if monitor.role == "replica" and monitor.status_port is not none %}
# The status endpoint reports a critical job, so a probe run that wrote every
# status file exits 0 with one; as a failed unit it read as a restart loop to
# the journal checks (obs_daily unit_loops, 2026-11-20). Any other failure
# still fails the unit. Without the endpoint the failed unit stays the alert.
Environment=RUSTFS_MONITOR_CRITICAL_EXIT=0
{% endif %}
ExecStartPre=/usr/bin/curl -fsS -o /dev/null --connect-timeout 5 --max-time 10 --retry 30 --retry-delay 3 --retry-max-time 180 --retry-all-errors {{ cfg.endpoint }}/health/ready
{% if monitor.role == "source" %}
ExecStart=/usr/bin/python3 -I -B {{ monitor.script_path }} heartbeat {{ cfg.endpoint }} {{ monitor.replica_endpoint }} {{ monitor.jobs_path }}
{% else %}
ExecStart=/usr/bin/python3 -I -B {{ monitor.script_path }} probe {{ cfg.endpoint }} {{ monitor.state_root }} {{ monitor.jobs_path }}
{% endif %}
TimeoutStartSec=900

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
{% if monitor.role == "replica" %}
ReadWritePaths={{ monitor.state_root }}
{% endif %}
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
