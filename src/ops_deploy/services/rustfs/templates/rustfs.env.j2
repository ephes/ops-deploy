# RustFS environment configuration
# Managed by ops-deploy - do not edit manually

RUSTFS_ACCESS_KEY="{{ root_access }}"
RUSTFS_SECRET_KEY="{{ root_secret }}"
RUSTFS_VOLUMES="{{ cfg.data_dir }}"
RUSTFS_ADDRESS="{{ cfg.bind_host }}:{{ cfg.api_port }}"
RUSTFS_REGION="{{ cfg.region }}"

# Only the S3 API listens: no console, no alternate protocols, no egress.
RUSTFS_CONSOLE_ENABLE="false"
RUSTFS_FTP_ENABLE="false"
RUSTFS_FTPS_ENABLE="false"
RUSTFS_SFTP_ENABLE="false"
RUSTFS_WEBDAV_ENABLE="false"
RUSTFS_CHECK_UPDATE="false"
RUSTFS_OBS_ENDPOINT=""
