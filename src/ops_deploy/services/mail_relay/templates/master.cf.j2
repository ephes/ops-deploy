# Postfix master.cf - Edge Relay Configuration
# Generated by Ansible - do not edit manually
# Role: mail_relay_deploy

# =============================================================================
# SMTP - Port 25 (inbound from internet)
# =============================================================================
{% if mail_relay_postscreen_enabled %}
smtp      inet  n       -       y       -       1       postscreen
smtpd     pass  -       -       y       -       -       smtpd
{% else %}
smtp      inet  n       -       y       -       -       smtpd
{% endif %}
  -o smtpd_tls_security_level={{ mail_relay_smtpd_tls_security_level }}
  -o smtpd_sasl_auth_enable=no
  -o smtpd_relay_restrictions=permit_mynetworks,reject_unauth_destination
{% if mail_relay_postscreen_enabled %}
dnsblog   unix  -       -       y       -       0       dnsblog
tlsproxy  unix  -       -       y       -       0       tlsproxy
{% endif %}

{% if mail_relay_submission_enabled %}
# =============================================================================
# Submission - Port 587 (outbound from backend)
# =============================================================================
# Note: sender_login binding is done on the backend, not here.
# Edge just relays authenticated mail from the backend.
# Note: chroot=n required for SASL auxprop to access /etc/sasldb2
submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
{% if mail_relay_submission_discard_spam %}
  -o cleanup_service_name=cleanup_submission
{% endif %}

# =============================================================================
# SMTPS - Port 465 (implicit TLS submission)
# =============================================================================
# Note: chroot=n required for SASL auxprop to access /etc/sasldb2
smtps     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
{% if mail_relay_submission_discard_spam %}
  -o cleanup_service_name=cleanup_submission
{% endif %}
{% if mail_relay_submission_discard_spam %}

# Cleanup for submission/smtps: discards mail the backend tagged as spam
# (mail_relay_submission_discard_spam). Top-level header only.
cleanup_submission unix n -     y       -       0       cleanup
  -o header_checks=regexp:/etc/postfix/submission_header_checks
  -o nested_header_checks=
  -o mime_header_checks=
{% endif %}
{% endif %}

# =============================================================================
# Internal Services
# =============================================================================
pickup    unix  n       -       y       60      1       pickup
cleanup   unix  n       -       y       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       y       1000?   1       tlsmgr
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       y       -       0       bounce
defer     unix  -       -       y       -       0       bounce
trace     unix  -       -       y       -       0       bounce
verify    unix  -       -       y       -       1       verify
flush     unix  n       -       y       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       y       -       -       smtp
relay     unix  -       -       y       -       -       smtp
  -o syslog_name=postfix/$service_name
showq     unix  n       -       y       -       -       showq
error     unix  -       -       y       -       -       error
retry     unix  -       -       y       -       -       error
discard   unix  -       -       y       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       y       -       -       lmtp
anvil     unix  -       -       y       -       1       anvil
scache    unix  -       -       y       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
