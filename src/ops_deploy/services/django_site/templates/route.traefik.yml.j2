# {{ managed }}
# Public website, no Basic Auth: {{ cfg.route.public_reason }}
http:
  routers:
{% if cfg.frontend %}
    # The frontend's paths go to it (priority 200), everything else to Django
    # (priority 100). Each prefix is matched as `Path(p) || PathPrefix(p/)`.
    {{ cfg.route.fqdn }}-{{ cfg.frontend.router }}-router:
      rule: "{{ next_rule }}"

      entryPoints:
        - web
      middlewares:
        - redirect
      service: {{ cfg.route.fqdn }}-next
      priority: 200

    {{ cfg.route.fqdn }}-{{ cfg.frontend.router }}-secure-router:
      rule: "{{ next_tls_rule }}"

      entryPoints:
        - web-secure
      middlewares:
        - csrf
        - sslHeaders
        - gzip-compress
      service: {{ cfg.route.fqdn }}-next
      priority: 200
      tls:
        certResolver: {{ cfg.route.cert_resolver }}

{% endif %}
    {{ cfg.route.fqdn }}-router:
      rule: "{{ cfg.route.host_rule }}"

      entryPoints:
        - web
      middlewares:
        - redirect
        - csrf
      service: {{ cfg.route.fqdn }}{{ '-django' if cfg.frontend else '' }}
{% if cfg.frontend %}
      priority: 100
{% endif %}

    {{ cfg.route.fqdn }}-secure-router:
      rule: "{{ cfg.route.tls_host_rule or cfg.route.host_rule }}"

      entryPoints:
        - web-secure
      middlewares:
        - csrf
        - sslHeaders
        - gzip-compress
{% if cfg.route.canonical_redirect_regex %}
        - redirect-canonical-host
{% endif %}
        - redirect-www
      service: {{ cfg.route.fqdn }}{{ '-django' if cfg.frontend else '' }}
{% if cfg.frontend %}
      priority: 100
{% endif %}
      tls:
        certResolver: {{ cfg.route.cert_resolver }}

  middlewares:
    redirect:
      redirectScheme:
        scheme: https
        permanent: true
    csrf:
      headers:
        hostsProxyHeaders: ["X-CSRFToken"]
    sslHeaders:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
          X-Forwarded-Port: "443"
    gzip-compress:
      compress: {}
    redirect-www:
      redirectRegex:
        regex: "^https?://www\\.(.+)"
        replacement: "https://${1}"
        permanent: false
{% if cfg.route.canonical_redirect_regex %}
    redirect-canonical-host:
      redirectRegex:
        regex: '{{ cfg.route.canonical_redirect_regex }}'
        replacement: '{{ cfg.route.canonical_redirect_replacement }}'
        permanent: true
{% endif %}

  services:
    {{ cfg.route.fqdn }}{{ '-django' if cfg.frontend else '' }}:
      loadBalancer:
        servers:
          - url: http://{{ cfg.route.backend }}:{{ cfg.app.port }}
{% if cfg.frontend %}
    {{ cfg.route.fqdn }}-next:
      loadBalancer:
        servers:
          - url: http://{{ cfg.route.backend }}:{{ cfg.frontend.port }}
{% endif %}
