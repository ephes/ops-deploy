# {{ managed }}
[Unit]
Description={{ cfg.title }} web application
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5
WorkingDirectory={{ cfg.app_path }}
User={{ cfg.user }}
Group={{ cfg.group_name }}
ExecStart={{ cfg.site_path }}/gunicorn.sh
{% if cfg.hardening %}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths={{ writable | join(' ') }}
{% endif %}

[Install]
WantedBy=multi-user.target
