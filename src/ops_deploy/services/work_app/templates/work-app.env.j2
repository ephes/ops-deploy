# Environment configuration for the work app
# This file is managed by Ansible - do not edit manually

DJANGO_SETTINGS_MODULE={{ cfg.django_settings_module }}
DJANGO_SECRET_KEY={{ secret_key }}
DJANGO_DEBUG={{ cfg.django_debug | lower }}
DJANGO_ALLOWED_HOSTS={{ cfg.django_allowed_hosts | join(',') }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ cfg.django_csrf_trusted_origins | join(',') }}
DJANGO_ADMIN_URL={{ cfg.django_admin_url }}

# Database (SQLite)
DATABASE_URL=sqlite:///{{ cfg.database_path }}

# Static files (served by WhiteNoise)
DJANGO_STATIC_ROOT={{ cfg.static_root }}

# Traefik terminates TLS; disable the redirect so local health checks work
DJANGO_SECURE_SSL_REDIRECT=False

# Relative evidence paths from the YAML ledger become links here
LEDGER_EVIDENCE_BASE_URL={{ cfg.evidence_base_url }}
