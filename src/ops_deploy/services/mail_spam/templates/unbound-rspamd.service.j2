# Generated by Ansible - do not edit manually
# Role: mail_spam_deploy (mail_spam_resolver_enabled)
[Unit]
Description=Private recursive resolver for rspamd DNSBL lookups
After=network-online.target
Wants=network-online.target
Before=rspamd.service

[Service]
Type=simple
# unbound-anchor exits 1 when it (re)wrote the anchor, hence "-". Run as the
# unbound user so the daemon can keep the RFC 5011 anchor file updated.
ExecStartPre=-/usr/sbin/runuser -u unbound -- /usr/sbin/unbound-anchor -a {{ mail_spam_resolver_state_dir }}/root.key
ExecStart=/usr/sbin/unbound -d -p -c {{ mail_spam_resolver_config }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
