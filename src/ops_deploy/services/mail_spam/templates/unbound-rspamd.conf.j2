# Private recursive resolver for rspamd (DNSBL/URIBL lookups)
# Generated by Ansible - do not edit manually
# Role: mail_spam_deploy (mail_spam_resolver_enabled)
#
# Recurses from the root itself (no forward-zone): blocklists refuse lookups
# that arrive via public resolvers. Not included by the distribution's unbound
# instance, which only reads /etc/unbound/unbound.conf.d/*.conf.

server:
    interface: {{ mail_spam_resolver_listen }}@{{ mail_spam_resolver_port }}
    port: {{ mail_spam_resolver_port }}
    access-control: 0.0.0.0/0 refuse
    access-control: ::0/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: ::1/128 allow
    username: "unbound"
    chroot: ""
    directory: "{{ mail_spam_resolver_state_dir }}"
    auto-trust-anchor-file: "{{ mail_spam_resolver_state_dir }}/root.key"
    use-syslog: yes
    log-identity: "{{ mail_spam_resolver_service }}"
    verbosity: 0
    hide-identity: yes
    hide-version: yes
    num-threads: 1
    msg-cache-size: 16m
    rrset-cache-size: 32m
    prefetch: yes

remote-control:
    control-enable: no
