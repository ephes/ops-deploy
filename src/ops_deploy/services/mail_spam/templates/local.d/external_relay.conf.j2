# rspamd external_relay configuration
# Generated by Ansible - do not edit manually

enabled = {{ 'true' if mail_spam_external_relay_enabled else 'false' }};
{% if mail_spam_external_relay_enabled %}
rules {
  # Use the first Received hop that is not from local_addrs as the sender.
  EXTERNAL_RELAY_LOCAL {
    strategy = "local";
  }
}
{% endif %}
