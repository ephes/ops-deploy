# rspamd global options
# Generated by Ansible - do not edit manually

# Built-in defaults plus mail_spam_local_addrs_extra.
local_addrs = {{ (mail_spam_local_addrs_default + mail_spam_local_addrs_extra) | to_json }};
{% if mail_spam_resolver_enabled %}

# Private recursive resolver first (DNSBLs refuse public resolvers), the host
# resolver as fallback. master-slave returns to the primary once it recovers.
dns {
  nameserver = "master-slave:{{ mail_spam_resolver_listen }}:{{ mail_spam_resolver_port }}{{ (',' ~ mail_spam_resolver_fallback) if mail_spam_resolver_fallback else '' }}";
}
{% endif %}
