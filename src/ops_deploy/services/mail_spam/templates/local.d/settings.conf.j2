# Generated by Ansible. All settings in this file are managed by this role.
{% if mail_spam_monitoring_probe | length > 0 %}
nyxmon_local_delivery_probe {
  priority = high;
  ip = {{ mail_spam_monitoring_probe.source_ip | to_json }};
  from = {{ mail_spam_monitoring_probe.sender | to_json }};
  rcpt = {{ mail_spam_monitoring_probe.recipient | to_json }};
  header = {
    "Subject" = {{ ('/^' ~ (mail_spam_monitoring_probe.subject_prefix | regex_escape) ~ '(?: |$)/') | to_json }};
  }
  apply {
    # Continue scanning/logging; disable score-based spam actions for this probe.
    actions {
      "add header" = null;
      "rewrite subject" = null;
      reject = null;
      greylist = null;
    }
  }
}
{% endif %}
