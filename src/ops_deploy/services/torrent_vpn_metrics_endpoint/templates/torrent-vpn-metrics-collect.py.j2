#!/usr/bin/env python3
"""Collector for torrent VPN egress metrics.

Provider-neutral: the VPN provider and the forwarded port are read from the
gluetun container's environment, so the checks follow the torrent deploy
without a second copy of its settings. Only those keys are read; no other
container environment (it holds the WireGuard key) is ever written out.

A leak and a failed probe are reported apart. egress_ok and provider_exit are
0 only on evidence of a leak (the namespace's public IPv4 equals the host's, or
the provider says the exit is not one of its own). When a probe gets no usable
answer, after the fallback IP services and one retry, the value is null,
probe_failed is 1 and probe_failures counts the consecutive runs with a failed
probe (kept in PROBE_STATE_PATH), so a monitor can alert on a persistent
outage without treating one blip as a leak.
"""
import ipaddress
import json
import os
import subprocess
import sys
import time
from typing import Dict, List, Optional, Set, Tuple

GLUETUN_CONTAINER = "{{ torrent_vpn_metrics_endpoint_gluetun_container }}"
ATTACHED_CONTAINERS = {{ torrent_vpn_metrics_endpoint_attached_containers | to_json }}
SCRIPT_TIMEOUT = {{ torrent_vpn_metrics_endpoint_script_timeout }}
HOST_IP_URL = "{{ torrent_vpn_metrics_endpoint_host_ip_url }}"
# Tried in order after HOST_IP_URL; each must return {"ip": "<IPv4>"}.
IP_FALLBACK_URLS = {{ torrent_vpn_metrics_endpoint_ip_fallback_urls | to_json }}
PROBE_RETRY_DELAY = {{ torrent_vpn_metrics_endpoint_probe_retry_delay }}
PROBE_STATE_PATH = "{{ torrent_vpn_metrics_endpoint_probe_state_path }}"
VPN_INTERFACE = "{{ torrent_vpn_metrics_endpoint_vpn_interface }}"
# provider -> {"url": ..., "flag": dotted path to a bool, "country": dotted path}
PROVIDER_CHECKS = {{ torrent_vpn_metrics_endpoint_provider_checks | to_json }}

DOCKER_ID_FORMAT = "{% raw %}{{.Id}}{% endraw %}"
DOCKER_PID_FORMAT = "{% raw %}{{.State.Pid}}{% endraw %}"
DOCKER_NETMODE_FORMAT = "{% raw %}{{.HostConfig.NetworkMode}}{% endraw %}"
DOCKER_ENV_FORMAT = "{% raw %}{{json .Config.Env}}{% endraw %}"
ENV_KEYS = ("VPN_SERVICE_PROVIDER", "FIREWALL_VPN_INPUT_PORTS")


def _run(cmd: List[str], timeout: Optional[int] = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=timeout)


def _docker_inspect(container: str, fmt: str) -> Tuple[Optional[str], Optional[str]]:
    result = _run(["docker", "inspect", "-f", fmt, container], timeout=5)
    if result.returncode != 0:
        return None, result.stderr.strip() or f"docker inspect failed for {container}"
    return result.stdout.strip(), None


def _in_netns(pid: int, cmd: List[str], timeout: int) -> subprocess.CompletedProcess[str]:
    return _run(["nsenter", "-t", str(pid), "-n", *cmd], timeout=timeout)


def parse_env(raw_json: Optional[str]) -> Dict[str, str]:
    """Pick ENV_KEYS out of `docker inspect` JSON env; ignore everything else."""
    picked: Dict[str, str] = {}
    try:
        entries = json.loads(raw_json or "[]")
    except json.JSONDecodeError:
        return picked
    for entry in entries if isinstance(entries, list) else []:
        key, _, value = str(entry).partition("=")
        if key in ENV_KEYS:
            picked[key] = value.strip()
    return picked


def parse_ports(value: Optional[str]) -> List[int]:
    ports = []
    for part in (value or "").split(","):
        part = part.strip()
        if part.isdigit():
            ports.append(int(part))
    return ports


def parse_ipv4(ip_addr_output: str) -> Optional[str]:
    """First IPv4 address from `ip -4 -o addr show <if>`."""
    for line in ip_addr_output.splitlines():
        fields = line.split()
        if "inet" in fields:
            return fields[fields.index("inet") + 1].split("/")[0]
    return None


def listening_ports(ss_output: str, address: str) -> Set[int]:
    """Ports with a listening socket bound to exactly `address` (`ss -Hlnt`)."""
    ports: Set[int] = set()
    for line in ss_output.splitlines():
        fields = line.split()
        if len(fields) < 4:
            continue
        host, _, port = fields[3].rpartition(":")
        # A socket bound to a device shows as "10.0.0.2%tun0".
        host = host.partition("%")[0]
        if host == address and port.isdigit():
            ports.add(int(port))
    return ports


def json_path(data: object, dotted: str) -> object:
    for key in dotted.split("."):
        if not isinstance(data, dict):
            return None
        data = data.get(key)
    return data


def as_bool(value: object) -> Optional[bool]:
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)):
        return bool(value)
    if isinstance(value, str) and value.strip().lower() in {"1", "true", "yes", "0", "false", "no"}:
        return value.strip().lower() in {"1", "true", "yes"}
    return None


def parse_ipv4_value(value: object) -> Optional[str]:
    """`value` as a normalised IPv4 string, or None if it is not one."""
    try:
        return str(ipaddress.IPv4Address(str(value).strip()))
    except (ipaddress.AddressValueError, ValueError):
        return None


def egress_verdict(host_ip: Optional[str], exit_ip: Optional[str]) -> Optional[int]:
    """1 when the exit differs from the host, 0 when equal (leak), None when unknown."""
    if host_ip is None or exit_ip is None:
        return None
    return 1 if host_ip != exit_ip else 0


def provider_verdict(flag: Optional[bool]) -> Optional[int]:
    """1/0 for an explicit provider answer, None when it gave none."""
    if flag is None:
        return None
    return 1 if flag else 0


def read_probe_failures(path: str) -> int:
    try:
        with open(path, encoding="utf-8") as handle:
            value = json.load(handle).get("probe_failures")
    except (OSError, ValueError, AttributeError):
        return 0
    return value if type(value) is int and value >= 0 else 0


def record_probe_result(path: str, failed: bool) -> Tuple[Optional[int], Optional[str]]:
    """Consecutive failed runs including this one, and a write error if any.

    When the count cannot be persisted during a failed run it would never
    climb past the stale stored value, so it is reported as None (unknown):
    `probe_failures < N` then fails instead of silently staying green.
    """
    count = read_probe_failures(path) + 1 if failed else 0
    tmp = f"{path}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump({"probe_failures": count, "ts": int(time.time())}, handle)
        os.replace(tmp, path)
    except OSError as exc:
        return (None if failed else count), f"probe state not written: {exc}"
    return count, None


def container_attached(mode: Optional[str], gluetun_name: str, gluetun_id: Optional[str]) -> bool:
    if not mode:
        return False
    candidates = {f"container:{gluetun_name}"}
    if gluetun_id:
        candidates |= {f"container:{gluetun_id}", f"container:{gluetun_id[:12]}"}
    return mode in candidates


class Collector:
    def __init__(self) -> None:
        self.error_type: Optional[str] = None
        self.message: Optional[str] = None
        self.probe_errors: List[str] = []

    def fail(self, error_type: str, message: str) -> None:
        if self.error_type is None:
            self.error_type = error_type
            self.message = message

    def probe_failed(self, error_type: str, message: str) -> None:
        self.probe_errors.append(error_type)
        self.fail(error_type, message)

    @staticmethod
    def fetch_json(cmd: List[str], label: str) -> Tuple[Optional[dict], str]:
        """One request; the parsed object, or None and why it failed."""
        try:
            result = _run(cmd, timeout=SCRIPT_TIMEOUT + 2)
        except subprocess.TimeoutExpired:
            return None, f"{label} request timed out"
        if result.returncode != 0:
            return None, result.stderr.strip() or f"{label} request failed"
        try:
            data = json.loads(result.stdout)
        except json.JSONDecodeError:
            return None, f"{label} response was not valid JSON"
        if not isinstance(data, dict):
            return None, f"{label} response was not a JSON object"
        return data, ""

    def public_ipv4(self, prefix: List[str], curl: List[str], label: str) -> Optional[str]:
        """Public IPv4 through the IP services in order, then once more after a pause."""
        reason = f"{label} request failed"
        for attempt in range(2):
            if attempt:
                time.sleep(PROBE_RETRY_DELAY)
            for url in [HOST_IP_URL, *IP_FALLBACK_URLS]:
                data, why = self.fetch_json([*prefix, *curl, "-4", url], label)
                ip = parse_ipv4_value((data or {}).get("ip")) if data is not None else None
                if ip is not None:
                    return ip
                reason = why or f"{label} response from {url} had no IPv4 ip"
        self.probe_failed(f"{label}_failed", reason)
        return None

    def provider_flag(self, prefix: List[str], curl: List[str], check: Dict[str, str]) -> Tuple[Optional[bool], object]:
        """The provider's explicit yes/no and the exit country; None when it gave no answer."""
        reason = "provider request failed"
        for attempt in range(2):
            if attempt:
                time.sleep(PROBE_RETRY_DELAY)
            data, why = self.fetch_json([*prefix, *curl, check["url"]], "provider")
            if data is None:
                reason = why
                continue
            flag = as_bool(json_path(data, check["flag"]))
            if flag is not None:
                return flag, json_path(data, check["country"])
            reason = f"provider response missing {check['flag']}"
        self.probe_failed("provider_failed", reason)
        return None, None

    def collect(self) -> dict:
        topology: Dict[str, object] = {
            "containers_ok": 0,
            "gluetun_container": GLUETUN_CONTAINER,
            "attached_containers": ATTACHED_CONTAINERS,
            "network_modes": {},
            "missing_containers": [],
        }
        vpn: Dict[str, object] = {
            "provider": None,
            "egress_ok": None,
            "provider_exit": None,
            "exit_ip_v4": None,
            "exit_country": None,
            "forwarded_port": None,
            "listen_tun_ok": 0,
            "tun_listen_ports": [],
        }

        gluetun_id, err = _docker_inspect(GLUETUN_CONTAINER, DOCKER_ID_FORMAT)
        if not gluetun_id:
            self.fail("gluetun_missing", err or f"gluetun container {GLUETUN_CONTAINER} not found")

        attached = bool(gluetun_id)
        for name in ATTACHED_CONTAINERS:
            mode, _ = _docker_inspect(name, DOCKER_NETMODE_FORMAT)
            topology["network_modes"][name] = mode  # type: ignore[index]
            if mode is None:
                topology["missing_containers"].append(name)  # type: ignore[union-attr]
            attached = attached and container_attached(mode, GLUETUN_CONTAINER, gluetun_id)
        topology["containers_ok"] = 1 if attached else 0

        pid = None
        if gluetun_id:
            pid_raw, err = _docker_inspect(GLUETUN_CONTAINER, DOCKER_PID_FORMAT)
            pid = int(pid_raw) if pid_raw and pid_raw.isdigit() and int(pid_raw) > 0 else None
            if pid is None:
                self.fail("gluetun_pid_missing", err or "gluetun PID missing or invalid")
            env_raw, _ = _docker_inspect(GLUETUN_CONTAINER, DOCKER_ENV_FORMAT)
            env = parse_env(env_raw)
            vpn["provider"] = env.get("VPN_SERVICE_PROVIDER") or None
            ports = parse_ports(env.get("FIREWALL_VPN_INPUT_PORTS"))
            vpn["forwarded_port"] = ports[0] if ports else None

        if pid is None:
            self.probe_errors.append("namespace_unavailable")
            return self.payload(topology, vpn)

        curl = ["curl", "-fsS", "--max-time", str(SCRIPT_TIMEOUT)]
        netns = ["nsenter", "-t", str(pid), "-n"]

        # Egress: the namespace's public IPv4 must differ from the host's.
        host_ip = self.public_ipv4([], curl, "host_ip")
        exit_ip = self.public_ipv4(netns, curl, "egress_ip")
        vpn["exit_ip_v4"] = exit_ip
        vpn["egress_ok"] = egress_verdict(host_ip, exit_ip)

        # Provider: its own "am I connected through us" API, from the namespace.
        check = PROVIDER_CHECKS.get(str(vpn["provider"] or ""))
        if check is None:
            self.probe_failed("provider_unknown", f"no provider check for {vpn['provider']!r}")
        else:
            flag, country = self.provider_flag(netns, curl, check)
            vpn["provider_exit"] = provider_verdict(flag)
            vpn["exit_country"] = country

        # qBittorrent listens on the tunnel address (and on the forwarded port).
        try:
            tun = _in_netns(pid, ["ip", "-4", "-o", "addr", "show", VPN_INTERFACE], 5)
            ss = _in_netns(pid, ["ss", "-Hlnt"], 5)
        except subprocess.TimeoutExpired:
            self.fail("listen_check_failed", "listener inspection timed out")
        else:
            tun_ip = parse_ipv4(tun.stdout) if tun.returncode == 0 else None
            ports = sorted(listening_ports(ss.stdout, tun_ip)) if tun_ip and ss.returncode == 0 else []
            vpn["tun_listen_ports"] = ports
            expected = vpn["forwarded_port"]
            vpn["listen_tun_ok"] = 1 if ports and (expected is None or expected in ports) else 0

        return self.payload(topology, vpn)

    def payload(self, topology: dict, vpn: dict) -> dict:
        failed = vpn["egress_ok"] is None or vpn["provider_exit"] is None
        vpn["probe_failed"] = 1 if failed else 0
        vpn["probe_errors"] = self.probe_errors
        vpn["probe_failures"], state_error = record_probe_result(PROBE_STATE_PATH, failed)
        vpn["probe_state_ok"] = 0 if state_error else 1
        if state_error:
            self.fail("probe_state_failed", state_error)
        return {
            "ts": int(time.time()),
            "topology": topology,
            "vpn": vpn,
            "error": self.error_type is not None,
            "error_type": self.error_type,
            "message": self.message,
        }


def main() -> int:
    try:
        payload = Collector().collect()
    except Exception as exc:  # pragma: no cover - defensive fallback
        failures, state_error = record_probe_result(PROBE_STATE_PATH, True)
        payload = {
            "ts": int(time.time()),
            "topology": {"containers_ok": 0},
            # Unknown, not a leak; the failure count still climbs.
            "vpn": {
                "egress_ok": None,
                "provider_exit": None,
                "listen_tun_ok": 0,
                "probe_failed": 1,
                "probe_errors": ["collector_failed"],
                "probe_failures": failures,
                "probe_state_ok": 0 if state_error else 1,
            },
            "error": True,
            "error_type": "collector_failed",
            "message": str(exc),
        }
    sys.stdout.write(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
