[Unit]
Description=Collect torrent VPN metrics and write to JSON file
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '{{ torrent_vpn_metrics_endpoint_collector_path }} > {{ torrent_vpn_metrics_endpoint_json_path }}.tmp && mv {{ torrent_vpn_metrics_endpoint_json_path }}.tmp {{ torrent_vpn_metrics_endpoint_json_path }}'

# Run as root to access Docker + network namespace
User=root
Group=root

# Ensure directory exists and has correct permissions
ExecStartPre=/bin/mkdir -p {{ torrent_vpn_metrics_endpoint_data_dir }}
ExecStartPre=/bin/chown root:{{ torrent_vpn_metrics_endpoint_group }} {{ torrent_vpn_metrics_endpoint_data_dir }}
ExecStartPre=/bin/chmod 0750 {{ torrent_vpn_metrics_endpoint_data_dir }}

# After writing, ensure the metrics user can read the file
ExecStartPost=/bin/chown root:{{ torrent_vpn_metrics_endpoint_group }} {{ torrent_vpn_metrics_endpoint_json_path }}
ExecStartPost=/bin/chmod 0640 {{ torrent_vpn_metrics_endpoint_json_path }}
