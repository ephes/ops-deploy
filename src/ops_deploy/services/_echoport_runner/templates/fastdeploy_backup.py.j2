# Archived sudoers files are restored only when every line is blank, a plain
# comment or the narrow rule shape the registration roles write; anything else
# (older fastdeploy_register_service files carried `deploy ALL=(root) NOPASSWD:
# ALL`; older backup registrations named scripts below FastDeploy's
# fastdeploy-owned site) stays out. Same check as fastdeploy_restore/files/sudoers_blanket_check.py
# (tests keep them equal).
_RESTORABLE_SUDO_RULE_RE = re.compile(
    r"^[a-z_][a-z0-9_-]*[ \t]+ALL[ \t]*=[ \t]*\("
    # run as deploy: a root-owned runner or one in the deploy user's own runner directory
    r"(?:deploy\)[ \t]*NOPASSWD:(?:NOSETENV:)?[ \t]*"
    r"(?:/usr/local/libexec/(?:fastdeploy/[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*|[A-Za-z0-9_][A-Za-z0-9._-]*)"
    r"|/home/deploy/runners/[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*)"
    # run as anyone else (root): only a root-owned runner
    r"|[A-Za-z_][A-Za-z0-9_-]*\)[ \t]*NOPASSWD:(?:NOSETENV:)?[ \t]*"
    r"/usr/local/libexec/(?:fastdeploy/[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*|[A-Za-z0-9_][A-Za-z0-9._-]*))"
    r"(?:[ \t]+(?:\*|--config[ \t]+\*))?[ \t]*$"
)


def sudoers_restorable(text: str) -> bool:
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        # Only "#" alone or "# text" is a comment: "#include", "#includedir" and
        # "#<uid> ..." (a rule for a numeric user ID) are directives or rules.
        if re.match(r"#(?:\s|$)", stripped):
            continue
        if not _RESTORABLE_SUDO_RULE_RE.match(stripped):
            return False
    return True

