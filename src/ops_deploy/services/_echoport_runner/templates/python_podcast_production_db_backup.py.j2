def _validate_ssh_identifier(value: str, name: str) -> None:
    """
    Validate that a value is safe for use in SSH commands.
    Prevents shell injection via remote_host or remote_user.
    """
    if not value:
        raise ValueError(f"{name} cannot be empty")
    if not _SSH_IDENTIFIER_RE.match(value):
        raise ValueError(
            f"{name} contains invalid characters (must match [a-zA-Z0-9._-]+): {value}"
        )


def public_schema_owner_sql(role: str) -> str:
    """The statement that gives the public schema to ``role`` (a quoted identifier)."""
    return f'ALTER SCHEMA public OWNER TO "{role}"'


def ssh(
    remote_host: str, remote_user: str, cmd: str, check: bool = True
) -> subprocess.CompletedProcess:
    """Execute command on remote host via SSH."""
    _validate_ssh_identifier(remote_host, "remote_host")
    _validate_ssh_identifier(remote_user, "remote_user")
    full_cmd = f"ssh {SSH_OPTS} {remote_user}@{remote_host} {shlex.quote(cmd)}"
    print(f"[SSH] {cmd}", file=sys.stderr)
    result = subprocess.run(full_cmd, shell=True, capture_output=True, text=True)
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(
            result.returncode, full_cmd, result.stdout, result.stderr
        )
    return result


def remote_unit_exists(remote_host: str, remote_user: str, unit: str) -> bool:
    """
    Return True when systemd knows the given unit on the remote host.

    Only an explicit LoadState of "not-found" counts as absent. A failed probe
    raises instead of reporting absence: reading a transient SSH or systemctl
    error as "no such unit" would silently skip stopping a worker and let the
    drop run while it still holds a connection - exactly the failure this
    guard exists to prevent.
    """
    result = ssh(
        remote_host,
        remote_user,
        f"systemctl show --property=LoadState --value {shlex.quote(unit)}",
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"Could not determine systemd state of {unit}: "
            f"{result.stderr.strip() or f'exit {result.returncode}'}"
        )
    return result.stdout.strip() != "not-found"


def resolve_restore_units(remote_host: str, remote_user: str) -> list:
    """
    Units to stop before, and start after, the destructive restore steps.

    SERVICE_NAME is always included. Auxiliary units are included only when they
    exist on the restore host, so a site without a db_worker restores unchanged.
    """
    units = [SERVICE_NAME]
    for unit in AUX_SERVICE_NAMES:
        if unit == SERVICE_NAME or unit in units:
            continue
        if remote_unit_exists(remote_host, remote_user, unit):
            units.append(unit)
        else:
            print(f"[INFO] Skipping unknown unit: {unit}", file=sys.stderr)
    return units


def scp_from_remote(
    remote_host: str, remote_user: str, remote_path: str, local_path: str
) -> None:
    """Copy file from remote host to local path."""
    _validate_ssh_identifier(remote_host, "remote_host")
    _validate_ssh_identifier(remote_user, "remote_user")
    full_cmd = f"scp -O {SSH_OPTS} {remote_user}@{remote_host}:{shlex.quote(remote_path)} {shlex.quote(local_path)}"
    print(f"[SCP] {remote_path} -> {local_path}", file=sys.stderr)
    result = subprocess.run(full_cmd, shell=True, capture_output=True, text=True)
    if result.returncode != 0:
        raise subprocess.CalledProcessError(
            result.returncode, full_cmd, result.stdout, result.stderr
        )


def scp_to_remote(
    remote_host: str, remote_user: str, local_path: str, remote_path: str
) -> None:
    """Copy file from local to remote host."""
    _validate_ssh_identifier(remote_host, "remote_host")
    _validate_ssh_identifier(remote_user, "remote_user")
    full_cmd = f"scp -O {SSH_OPTS} {shlex.quote(local_path)} {remote_user}@{remote_host}:{shlex.quote(remote_path)}"
    print(f"[SCP] {local_path} -> {remote_path}", file=sys.stderr)
    result = subprocess.run(full_cmd, shell=True, capture_output=True, text=True)
    if result.returncode != 0:
        raise subprocess.CalledProcessError(
            result.returncode, full_cmd, result.stdout, result.stderr
        )


def calculate_sha256(filepath: Path) -> str:
    """Calculate SHA256 checksum of a file."""
    sha256_hash = hashlib.sha256()
    with open(filepath, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            sha256_hash.update(chunk)
    return sha256_hash.hexdigest()


def _is_safe_tar_member(member: tarfile.TarInfo, dest_dir: Path) -> tuple[bool, str]:
    """
    Check if a tar member is safe to extract.

    Prevents path traversal attacks by ensuring:
    1. No special file types (device nodes, FIFOs)
    2. No absolute paths
    3. No paths escaping dest_dir via ..
    4. No symlinks/hardlinks pointing outside dest_dir

    Returns (is_safe, error_message).
    """
    # Reject special file types
    if member.isdev() or member.ischr() or member.isblk():
        return False, f"Tarball contains device node: {member.name}"
    if member.isfifo():
        return False, f"Tarball contains FIFO: {member.name}"

    # Check for absolute paths
    if member.name.startswith("/"):
        return False, f"Tarball contains absolute path: {member.name}"

    # Check for path traversal
    if ".." in member.name:
        return False, f"Tarball contains path traversal: {member.name}"

    # Resolve the target path and ensure it's within dest_dir
    target_path = (dest_dir / member.name).resolve()
    try:
        target_path.relative_to(dest_dir.resolve())
    except ValueError:
        return False, f"Tarball member escapes dest_dir: {member.name}"

    # Check symlinks point within dest_dir
    if member.issym():
        link_target = Path(member.linkname)
        if link_target.is_absolute():
            return False, f"Tarball contains symlink with absolute target: {member.name} -> {member.linkname}"
        # Resolve relative to the symlink's directory
        link_resolved = (target_path.parent / link_target).resolve()
        try:
            link_resolved.relative_to(dest_dir.resolve())
        except ValueError:
            return False, f"Tarball contains symlink escaping dest_dir: {member.name} -> {member.linkname}"

    # Check hardlinks point within dest_dir
    if member.islnk():
        link_target = (dest_dir / member.linkname).resolve()
        try:
            link_target.relative_to(dest_dir.resolve())
        except ValueError:
            return False, f"Tarball contains hardlink escaping dest_dir: {member.name} -> {member.linkname}"

    return True, ""


def _is_private_media_name(name: str) -> bool:
    """
    True when an archive path names private media of the outer archive.

    The path is normalized first, so "./private_media/..." or
    "database/../private_media/..." cannot slip past the filter.
    """
    top = PRIVATE_MEDIA_ARCNAME.split("/", 1)[0]
    normalized = posixpath.normpath(name.lstrip("/"))
    return normalized == top or normalized.startswith(top + "/")


def safe_extract_tarball(
    tarball_path: Path, extract_dir: Path, include_private_media: bool = False
) -> None:
    """
    Extract tarball with security validation.
    Rejects absolute paths, path traversal, and unsafe symlinks/hardlinks.

    Every member is validated, but private media members are only extracted
    when include_private_media is set, so a default staging restore never
    unpacks production voice clips.

    This runner only ever writes regular files and directories into the
    outer archive, so links are rejected outright: a symlinked ancestor
    (alias -> .) or a hardlink could otherwise route a private media member
    past the name-based filter.
    """
    with tarfile.open(tarball_path, "r:gz") as tar:
        safe_members = []
        for member in tar.getmembers():
            is_safe, error_msg = _is_safe_tar_member(member, extract_dir)
            if not is_safe:
                raise ValueError(error_msg)
            if member.issym() or member.islnk():
                raise ValueError(f"Tarball contains a link (not written by this runner): {member.name}")
            if not include_private_media and _is_private_media_name(member.name):
                continue
            safe_members.append(member)

        # Extract only validated members
        tar.extractall(extract_dir, members=safe_members)


# Remote paths and owners are Ansible-templated, but they end up in remote
# shell commands, so validate them like the SSH identifiers above.
_SAFE_REMOTE_PATH_RE = re.compile(r"^/[A-Za-z0-9._/-]+$")
_SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")
_SAFE_OWNER_RE = re.compile(r"^[a-z_][a-z0-9_-]*:[a-z_][a-z0-9_-]*$")


def validate_private_media_path(path: str, name: str) -> str:
    """Return the normalized absolute path or raise ValueError."""
    if not path or not _SAFE_REMOTE_PATH_RE.match(path):
        raise ValueError(f"{name} must be an absolute path of [A-Za-z0-9._/-]: {path!r}")
    normalized = path.rstrip("/")
    parts = normalized.split("/")[1:]
    if len(parts) < 2 or any(part in ("", ".", "..") for part in parts):
        raise ValueError(f"{name} must be a normalized path at least two levels deep: {path!r}")
    return normalized


def validate_restore_owner(owner: str) -> str:
    """Return a user:group owner string or raise ValueError."""
    if not _SAFE_OWNER_RE.match(owner):
        raise ValueError(f"private media restore owner must be user:group: {owner!r}")
    return owner


def _process_error(error: Exception) -> str:
    """Readable message for subprocess and validation errors."""
    if isinstance(error, subprocess.CalledProcessError):
        detail = (error.stderr or "").strip() or f"exit {error.returncode}"
        return detail
    return str(error)


def probe_remote_directory(remote_host: str, remote_user: str, path: str) -> str:
    """
    Return "present", "missing", "symlink" or "notdir" for a remote path.

    A failed probe raises instead of reporting the directory missing: reading
    an SSH error as "missing" would silently drop private media from the
    backup.
    """
    quoted = shlex.quote(path)
    # The remote login shell may be fish, which cannot parse if/then/fi, so
    # the probe runs under sh.
    script = (
        f"if test -L {quoted}; then echo symlink; "
        f"elif test -d {quoted}; then echo present; "
        f"elif test -e {quoted}; then echo notdir; "
        f"else echo missing; fi"
    )
    result = ssh(remote_host, remote_user, f"sh -c {shlex.quote(script)}", check=False)
    state = result.stdout.strip()
    if result.returncode != 0 or state not in ("present", "missing", "symlink", "notdir"):
        raise RuntimeError(
            f"Could not probe {path} on {remote_host}: "
            f"{result.stderr.strip() or f'exit {result.returncode}'}"
        )
    return state


def verify_private_media_archive(archive_path: Path, root_name: str) -> tuple[int, int]:
    """
    Validate a private media archive and return (file_count, total_bytes).

    Every member must pass the same tar-member safety check as the outer
    archive, sit under root_name, and be a regular file or directory. Links
    and special files are rejected outright, and the uncompressed size must
    stay within PRIVATE_MEDIA_MAX_BYTES (the tree may have grown between the
    du guard and the tar run).
    """
    if not _SAFE_NAME_RE.match(root_name) or root_name in (".", ".."):
        raise ValueError(f"Invalid private media archive root: {root_name!r}")
    check_dir = archive_path.parent / "private-media-member-check"
    file_count = 0
    total_bytes = 0
    saw_root = False
    with tarfile.open(archive_path, "r:gz") as tar:
        for member in tar.getmembers():
            name = member.name.rstrip("/")
            is_safe, error_msg = _is_safe_tar_member(member, check_dir)
            if not is_safe:
                raise ValueError(f"Private media archive: {error_msg}")
            if name != root_name and not name.startswith(root_name + "/"):
                raise ValueError(f"Private media archive member outside {root_name}/: {member.name}")
            if member.isdir():
                saw_root = saw_root or name == root_name
                continue
            if not member.isfile():
                raise ValueError(f"Private media archive contains a non-regular file: {member.name}")
            file_count += 1
            total_bytes += member.size
            if total_bytes > PRIVATE_MEDIA_MAX_BYTES:
                raise ValueError(
                    f"Private media archive exceeds {PRIVATE_MEDIA_MAX_BYTES:,} bytes uncompressed"
                )
    if not saw_root:
        raise ValueError(f"Private media archive has no {root_name}/ directory")
    return file_count, total_bytes


_REMOTE_TEMP_DIR_RE = re.compile(r"^/tmp/echoport-pp-private-media\.[A-Za-z0-9]+$")


def make_remote_private_dir(remote_host: str, remote_user: str) -> str:
    """
    Create a private (0700) temp directory on the remote host and return it.

    Archives of voice recordings never go to a predictable /tmp file name:
    root writing through a pre-created symlink, or into a pre-created
    world-readable file, would overwrite files or expose the recordings.
    """
    result = ssh(remote_host, remote_user, "mktemp -d /tmp/echoport-pp-private-media.XXXXXXXX")
    path = result.stdout.strip()
    if not _REMOTE_TEMP_DIR_RE.match(path):
        raise RuntimeError(f"Unexpected remote mktemp output: {path!r}")
    return path


def remove_remote_private_dirs(remote_host: str, remote_user: str, dirs: list) -> bool:
    """Best-effort removal of directories made by make_remote_private_dir."""
    ok = True
    for path in dirs:
        if not _REMOTE_TEMP_DIR_RE.match(path):
            continue
        try:
            result = ssh(remote_host, remote_user, f"rm -rf -- {shlex.quote(path)}", check=False)
            if result.returncode != 0:
                print(f"[WARN] Remote cleanup of {path} returned non-zero: {result.stderr}", file=sys.stderr)
                ok = False
        except Exception as e:
            print(f"[WARN] Remote cleanup of {path} failed: {e}", file=sys.stderr)
            ok = False
    return ok


def backup_private_media(work_dir: Path, remote_dirs: list) -> Optional[Dict]:
    """
    Copy PRIVATE_MEDIA_PATH from production into work_dir as a verified tarball.

    Returns None when no path is configured, a manifest entry with
    included=False when the directory does not exist on production (a warning,
    not a failure: the site may not have stored any voice reference yet), and
    the full manifest entry otherwise. Any other problem raises, so the backup
    fails loudly instead of silently omitting private media.
    """
    if not PRIVATE_MEDIA_PATH:
        emit_step("backup_private_media", "success", "Skipped: no private media path configured")
        return None

    path = validate_private_media_path(PRIVATE_MEDIA_PATH, "private_media_path")
    emit_step("backup_private_media", "running", f"Archiving {path} on {BACKUP_HOST}")

    state = probe_remote_directory(BACKUP_HOST, REMOTE_USER, path)
    if state == "missing":
        warning = f"WARNING: {path} does not exist on {BACKUP_HOST}; no private media included"
        print(f"[WARN] {warning}", file=sys.stderr)
        emit_step("backup_private_media", "success", warning)
        return {"included": False, "source": path, "reason": "missing"}
    if state != "present":
        raise RuntimeError(f"{path} on {BACKUP_HOST} is a {state}, not a directory")

    # Size guard before archiving anything.
    du = ssh(BACKUP_HOST, REMOTE_USER, f"du -sb -- {shlex.quote(path)}")
    try:
        size_on_disk = int(du.stdout.split()[0])
    except (IndexError, ValueError) as e:
        raise RuntimeError(f"Could not parse du output for {path}: {du.stdout!r}") from e
    if size_on_disk > PRIVATE_MEDIA_MAX_BYTES:
        raise RuntimeError(
            f"{path} holds {size_on_disk:,} bytes, above the {PRIVATE_MEDIA_MAX_BYTES:,} byte guard "
            "(raise pp_prod_db_backup_private_media_max_bytes if this is expected)"
        )

    # Read-only on the source tree: tar only reads it. The archive goes into
    # a fresh 0700 directory (registered for cleanup before anything is
    # written) because it holds personal voice recordings.
    parent, root_name = path.rsplit("/", 1)
    remote_dir = make_remote_private_dir(BACKUP_HOST, REMOTE_USER)
    remote_dirs.append(remote_dir)
    remote_archive_path = f"{remote_dir}/private_media.tar.gz"
    ssh(
        BACKUP_HOST,
        REMOTE_USER,
        f"umask 077 && tar -C {shlex.quote(parent)} -czf {shlex.quote(remote_archive_path)} "
        f"-- {shlex.quote(root_name)}",
    )

    local_archive = work_dir / "private_media.tar.gz"
    scp_from_remote(BACKUP_HOST, REMOTE_USER, remote_archive_path, str(local_archive))
    file_count, total_bytes = verify_private_media_archive(local_archive, root_name)

    entry = {
        "included": True,
        "source": path,
        "root": root_name,
        "format": "tar.gz",
        "filename": PRIVATE_MEDIA_ARCNAME,
        "size": local_archive.stat().st_size,
        "checksum_sha256": calculate_sha256(local_archive),
        "file_count": file_count,
        "uncompressed_bytes": total_bytes,
    }
    emit_step(
        "backup_private_media",
        "success",
        f"Private media archived ({file_count} files, {total_bytes:,} bytes)",
    )
    return entry


def prepare_private_media_restore(extract_dir: Path) -> Optional[tuple[Path, str]]:
    """
    Locate and verify the private media archive of an extracted backup.

    Returns (archive_path, root_name), or None when the backup carries no
    private media (older backups, or a production host without the
    directory). Raises ValueError when the archive is present but does not
    match its manifest checksum or fails the member safety check.
    """
    manifest_path = extract_dir / "manifest.json"
    manifest = json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
    entry = manifest.get("private_media") or {}
    if not entry.get("included"):
        return None

    archive_path = extract_dir / PRIVATE_MEDIA_ARCNAME
    if not archive_path.is_file():
        raise ValueError(f"Manifest lists private media but {PRIVATE_MEDIA_ARCNAME} is missing")
    expected = str(entry.get("checksum_sha256", ""))
    actual = calculate_sha256(archive_path)
    if not expected or actual != expected:
        raise ValueError(
            f"Private media checksum mismatch: expected {expected or '(none)'}, got {actual}"
        )
    root_name = str(entry.get("root", ""))
    verify_private_media_archive(archive_path, root_name)
    return archive_path, root_name


def install_private_media_script(
    remote_archive_path: str, root_name: str, target: str, owner: str
) -> str:
    """
    Shell script that swaps the staged private media into place on the
    restore host. The archive is extracted into $stage/new and the previous
    tree is parked in $stage/old (separate directories, so no archive root
    name can collide with it). The previous tree is moved back if the swap
    fails, so a failed restore leaves either the old or the new tree.
    """
    parent = target.rsplit("/", 1)[0]
    q = shlex.quote
    return "\n".join(
        [
            "set -eu",
            f"target={q(target)}",
            f"stage=$(mktemp -d {q(parent)}/.echoport-private-media.XXXXXX)",
            'mkdir "$stage/new" "$stage/old"',
            f"tar -xzf {q(remote_archive_path)} -C \"$stage/new\" --no-same-owner",
            f"test -d \"$stage/new\"/{q(root_name)}",
            f"chown -R {q(owner)} \"$stage/new\"/{q(root_name)}",
            'test ! -L "$target"',
            'moved=0',
            'if test -e "$target"; then mv "$target" "$stage/old/tree"; moved=1; fi',
            f"if ! mv \"$stage/new\"/{q(root_name)} \"$target\"; then",
            '  if test "$moved" = 1; then mv "$stage/old/tree" "$target"; fi',
            '  exit 1',
            'fi',
            'rm -rf "$stage"',
        ]
    )


def backup(
    bucket: str,
    key_prefix: str,
    timestamp: str,
) -> int:
    """
    Perform PostgreSQL backup from remote production server.

    Steps:
    1. Validate config
    2. SSH pg_dump on production
    3. SCP dump to macmini
    4. Verify dump with pg_restore --list
    5. Optionally tar PRIVATE_MEDIA_PATH on production (size-guarded), copy
       it back and verify its members
    6. Create manifest and tarball, upload to MinIO
    7. Verify upload
    8. Cleanup production temp files

    No service stop needed - pg_dump provides consistent snapshots.

    Returns 0 on success, 1 on failure.
    """
    dump_filename = f"python-podcast.dump"
    remote_dump_path = f"/tmp/echoport_pp_dump_{timestamp}.dump"
    remote_private_dirs: list = []

    # Fail closed before any other work: the run dir must be on WORK_MOUNT.
    work_dir = open_run_dir("pp-backup-", "Backup")
    if work_dir is None:
        return 1
    backup_success = False
    result_data = {}

    try:
        emit_step("init", "running", "Starting PostgreSQL backup")

        # Validate SSH identifiers
        _validate_ssh_identifier(BACKUP_HOST, "backup_host")
        _validate_ssh_identifier(REMOTE_USER, "remote_user")

        emit_step("init", "success", f"Configuration validated (db: {DB_NAME})")

        # pg_dump on production (no service stop needed)
        emit_step("dump_database", "running", f"Running pg_dump on {BACKUP_HOST}")
        try:
            ssh(
                BACKUP_HOST,
                REMOTE_USER,
                f"sudo -u postgres pg_dump --format=custom --file={shlex.quote(remote_dump_path)} --dbname={shlex.quote(DB_NAME)}",
            )
            emit_step("dump_database", "success", "pg_dump completed")
        except subprocess.CalledProcessError as e:
            emit_step("dump_database", "failure", f"pg_dump failed: {e.stderr}")
            emit_result(success=False, error=f"pg_dump failed: {e.stderr}")
            finish_stdout("failure", "pg_dump failed")
            return 1

        # SCP dump from production to local temp dir
        emit_step("copy_dump", "running", "Copying dump from production")
        local_dump_path = work_dir / dump_filename
        try:
            scp_from_remote(BACKUP_HOST, REMOTE_USER, remote_dump_path, str(local_dump_path))
            emit_step("copy_dump", "success", f"Dump copied ({local_dump_path.stat().st_size:,} bytes)")
        except subprocess.CalledProcessError as e:
            emit_step("copy_dump", "failure", f"Failed to copy dump: {e.stderr}")
            emit_result(success=False, error=f"Failed to copy dump: {e.stderr}")
            finish_stdout("failure", "Dump copy failed")
            return 1

        # Verify dump readability with pg_restore --list
        emit_step("verify_dump", "running", "Verifying dump readability")
        result = subprocess.run(
            ["pg_restore", "--list", str(local_dump_path)],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            emit_step("verify_dump", "failure", f"pg_restore --list failed: {result.stderr}")
            emit_result(success=False, error=f"Dump verification failed: {result.stderr}")
            finish_stdout("failure", "Dump verification failed")
            return 1

        emit_step("verify_dump", "success", "Dump verified readable")

        # Private media (voice references) - not in pg_dump, not on S3
        try:
            private_media = backup_private_media(work_dir, remote_private_dirs)
        except (subprocess.CalledProcessError, RuntimeError, ValueError, tarfile.TarError) as e:
            error_msg = f"Private media backup failed: {_process_error(e)}"
            emit_step("backup_private_media", "failure", error_msg)
            emit_result(success=False, error=error_msg)
            finish_stdout("failure", "Private media backup failed")
            return 1
        private_media_included = bool(private_media and private_media.get("included"))

        # Create manifest
        dump_size = local_dump_path.stat().st_size
        dump_checksum = calculate_sha256(local_dump_path)
        manifest = {
            "target": "python-podcast-production-db",
            "timestamp": timestamp,
            "database": {
                "type": "postgresql",
                "dbname": DB_NAME,
                "format": "custom",
                "filename": f"database/{dump_filename}",
                "size": dump_size,
                "checksum_sha256": dump_checksum,
            },
        }
        if private_media is not None:
            manifest["private_media"] = private_media
        manifest_path = work_dir / "manifest.json"
        manifest_path.write_text(json.dumps(manifest, indent=2))

        # Create tarball and upload
        emit_step("upload", "running", "Creating archive and uploading")
        tarball_path = work_dir / f"{timestamp}.tar.gz"
        with tarfile.open(tarball_path, "w:gz") as tar:
            tar.add(local_dump_path, arcname=f"database/{dump_filename}")
            tar.add(manifest_path, arcname="manifest.json")
            if private_media_included:
                tar.add(work_dir / "private_media.tar.gz", arcname=PRIVATE_MEDIA_ARCNAME)

        # Calculate checksum
        checksum = calculate_sha256(tarball_path)
        size_bytes = tarball_path.stat().st_size

        # Upload to MinIO
        key = f"{key_prefix}.tar.gz"
        result = subprocess.run(
            [MC_PATH, "cp", str(tarball_path), f"{MINIO_ALIAS}/{bucket}/{key}"],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            emit_step("upload", "failure", f"MinIO upload failed: {result.stderr}")
            emit_result(success=False, error=f"MinIO upload failed: {result.stderr}")
            finish_stdout("failure", "Upload failed")
            return 1

        emit_step("upload", "success", f"Uploaded {size_bytes:,} bytes")

        # Verify upload
        emit_step("verify", "running", "Verifying upload")
        result = subprocess.run(
            [MC_PATH, "stat", f"{MINIO_ALIAS}/{bucket}/{key}"],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            emit_step("verify", "failure", "Upload verification failed")
            emit_result(success=False, error="Upload verification failed")
            finish_stdout("failure", "Verification failed")
            return 1

        emit_step("verify", "success", "Backup verified in MinIO")

        backup_success = True
        result_data = {
            "bucket": bucket,
            "key": key,
            "size_bytes": size_bytes,
            "checksum_sha256": checksum,
            "file_count": 2 if private_media_included else 1,
        }

    except Exception as e:
        print(f"Backup failed with error: {e}", file=sys.stderr)
        emit_step("error", "failure", str(e))
        emit_result(success=False, error=str(e))
        finish_stdout("failure", f"Unexpected error: {e}")
        return 1
    finally:
        # Always clean up remote dump and private media archive
        emit_step("cleanup", "running", "Cleaning up temporary files")
        cleanup_ok = True
        try:
            result = ssh(BACKUP_HOST, REMOTE_USER, f"rm -f {shlex.quote(remote_dump_path)}", check=False)
            if result.returncode != 0:
                print(f"[WARN] Remote cleanup returned non-zero: {result.stderr}", file=sys.stderr)
                cleanup_ok = False
        except Exception as e:
            print(f"[WARN] Remote cleanup failed: {e}", file=sys.stderr)
            cleanup_ok = False
        if not remove_remote_private_dirs(BACKUP_HOST, REMOTE_USER, remote_private_dirs):
            cleanup_ok = False

        # Clean up local temp directory
        shutil.rmtree(work_dir, ignore_errors=True)

        if cleanup_ok:
            emit_step("cleanup", "success", "Temporary files cleaned")
        else:
            emit_step("cleanup", "success", "Temporary files cleaned (remote cleanup warning)")

        # Emit final result
        if backup_success:
            emit_result(success=True, **result_data)
            finish_stdout("success", f"Backup completed: {result_data.get('bucket')}/{result_data.get('key')}")
            return 0

    return 1  # Should not reach here, but return failure as safety


def restore(
    bucket: str,
    key: str,
    expected_checksum: str,
    include_private_media: bool = False,
) -> int:
    """
    Perform PostgreSQL restore to remote staging server.

    Steps:
    1. Download backup from MinIO
    2. Verify checksum (hard-fail on mismatch)
    3. Extract with safety validation (private media only when opted in)
    4. SCP dump (and opted-in private media) to staging
    5. Stop service and auxiliary units (db_worker)
    6. Drop/recreate database
    7. pg_restore
    8. Opted in only: swap private media into RESTORE_PRIVATE_MEDIA_PATH
    9. Start service and auxiliary units
    10. Post-check SQL connectivity
    11. Cleanup

    Private media is skipped by default so production voice clips do not
    spread to staging unasked; staging's own private media stays untouched.

    Returns 0 on success, 1 on failure.
    """
    dump_filename = "python-podcast.dump"
    restore_stamp = datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')
    remote_dump_path = f"/tmp/echoport_pp_restore_{restore_stamp}.dump"
    remote_private_dirs: list = []
    remote_private_media_path = ""
    private_media_restore = None
    private_media_target = ""
    private_media_owner = ""

    # Fail closed before any other work: the run dir must be on WORK_MOUNT.
    work_dir = open_run_dir("pp-restore-", "Restore")
    if work_dir is None:
        return 1
    stopped_services = []
    restore_success = False
    result_data = {}

    try:
        emit_step("init", "running", "Starting PostgreSQL restore")

        # Validate SSH identifiers
        _validate_ssh_identifier(RESTORE_HOST, "restore_host")
        _validate_ssh_identifier(REMOTE_USER, "remote_user")
        if include_private_media:
            private_media_target = validate_private_media_path(
                RESTORE_PRIVATE_MEDIA_PATH, "restore_private_media_path"
            )
            private_media_owner = validate_restore_owner(RESTORE_PRIVATE_MEDIA_OWNER)

        emit_step("init", "success", f"Configuration validated (db: {DB_NAME})")

        # Download backup from MinIO
        emit_step("download", "running", "Downloading backup from MinIO")
        tarball_path = work_dir / "backup.tar.gz"
        result = subprocess.run(
            [MC_PATH, "cp", f"{MINIO_ALIAS}/{bucket}/{key}", str(tarball_path)],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            emit_step("download", "failure", f"Download failed: {result.stderr}")
            emit_result(success=False, error=f"Download failed: {result.stderr}")
            finish_stdout("failure", "Download failed")
            return 1

        emit_step("download", "success", f"Downloaded backup ({tarball_path.stat().st_size:,} bytes)")

        # Verify checksum (hard-fail on mismatch)
        emit_step("verify_checksum", "running", "Verifying checksum")
        actual_checksum = calculate_sha256(tarball_path)
        if actual_checksum != expected_checksum:
            error_msg = f"Checksum mismatch: expected {expected_checksum}, got {actual_checksum}"
            emit_step("verify_checksum", "failure", error_msg)
            emit_result(success=False, error=error_msg)
            finish_stdout("failure", "Checksum verification failed")
            return 1

        emit_step("verify_checksum", "success", "Backup integrity verified")

        # Extract with safety validation
        emit_step("extract", "running", "Extracting backup")
        extract_dir = work_dir / "extracted"
        extract_dir.mkdir()
        try:
            safe_extract_tarball(
                tarball_path, extract_dir, include_private_media=include_private_media
            )
        except ValueError as e:
            emit_step("extract", "failure", str(e))
            emit_result(success=False, error=str(e))
            finish_stdout("failure", "Extraction failed")
            return 1

        # Validate dump file exists in archive (under database/ subdir)
        dump_path = extract_dir / "database" / dump_filename
        if not dump_path.exists():
            # Fallback: check manifest for filename, try both database/ and root
            manifest_path = extract_dir / "manifest.json"
            if manifest_path.exists():
                manifest = json.loads(manifest_path.read_text())
                alt_filename = manifest.get("database", {}).get("filename", "")
                if alt_filename:
                    for candidate in [extract_dir / "database" / alt_filename, extract_dir / alt_filename]:
                        if candidate.exists():
                            dump_path = candidate
                            break

        if not dump_path.exists():
            emit_step("extract", "failure", f"Missing dump file: database/{dump_filename}")
            emit_result(success=False, error=f"Missing dump file: {dump_filename}")
            finish_stdout("failure", "Invalid backup archive")
            return 1

        emit_step("extract", "success", "Backup extracted")

        # Private media: verified before anything destructive happens
        if include_private_media:
            emit_step("restore_private_media", "running", "Verifying private media archive")
            try:
                private_media_restore = prepare_private_media_restore(extract_dir)
            except (ValueError, tarfile.TarError, json.JSONDecodeError) as e:
                emit_step("restore_private_media", "failure", str(e))
                emit_result(success=False, error=f"Private media verification failed: {e}")
                finish_stdout("failure", "Private media verification failed")
                return 1
            if private_media_restore is None:
                warning = "WARNING: backup contains no private media; staging private media left unchanged"
                print(f"[WARN] {warning}", file=sys.stderr)
                emit_step("restore_private_media", "success", warning)
            else:
                emit_step("restore_private_media", "running", "Private media archive verified")
        else:
            emit_step(
                "restore_private_media",
                "success",
                f"Skipped: private media not restored (opt in with {INCLUDE_PRIVATE_MEDIA_FLAG})",
            )

        # SCP dump to staging. Classic scp creates the remote file with the
        # local mode, and pg_restore reads it there as postgres, so the dump
        # must be world-readable even if the archive carries it 0600. Locally
        # it stays private: the run dir is 0700.
        os.chmod(dump_path, 0o644)
        emit_step("upload_dump", "running", "Uploading dump to staging")
        try:
            scp_to_remote(RESTORE_HOST, REMOTE_USER, str(dump_path), remote_dump_path)
            if private_media_restore is not None:
                remote_dir = make_remote_private_dir(RESTORE_HOST, REMOTE_USER)
                remote_private_dirs.append(remote_dir)
                remote_private_media_path = f"{remote_dir}/private_media.tar.gz"
                scp_to_remote(
                    RESTORE_HOST,
                    REMOTE_USER,
                    str(private_media_restore[0]),
                    remote_private_media_path,
                )
            emit_step("upload_dump", "success", "Dump uploaded to staging")
        except subprocess.CalledProcessError as e:
            emit_step("upload_dump", "failure", f"Failed to upload dump: {e.stderr}")
            emit_result(success=False, error=f"Failed to upload dump: {e.stderr}")
            finish_stdout("failure", "Dump upload failed")
            return 1

        # Stop service and auxiliary units. Everything that talks to the database
        # must be down before the drop, otherwise it crashes mid-restore.
        restore_units = resolve_restore_units(RESTORE_HOST, REMOTE_USER)
        emit_step("stop_service", "running", f"Stopping {', '.join(restore_units)}")
        try:
            for unit in restore_units:
                ssh(RESTORE_HOST, REMOTE_USER, f"systemctl stop {shlex.quote(unit)}")
                stopped_services.append(unit)
            emit_step("stop_service", "success", f"Stopped {', '.join(restore_units)}")
        except subprocess.CalledProcessError as e:
            emit_step("stop_service", "failure", f"Failed to stop service: {e.stderr}")
            emit_result(success=False, error=f"Failed to stop service: {e.stderr}")
            finish_stdout("failure", "Failed to stop service")
            return 1

        # Drop and recreate database
        emit_step("drop_recreate_db", "running", f"Dropping and recreating database {DB_NAME}")
        try:
            ssh(
                RESTORE_HOST,
                REMOTE_USER,
                f"sudo -u postgres dropdb --if-exists --force {shlex.quote(DB_NAME)}",
            )
            ssh(
                RESTORE_HOST,
                REMOTE_USER,
                f"sudo -u postgres createdb --owner={shlex.quote(DB_USER)} {shlex.quote(DB_NAME)}",
            )
            # createdb copies template1, whose public schema can still belong
            # to postgres (clusters upgraded from PostgreSQL < 15), and
            # pg_restore --no-owner skips the dump's ALTER SCHEMA ... OWNER.
            # Hand the schema to the app role before restoring into it.
            ssh(
                RESTORE_HOST,
                REMOTE_USER,
                "sudo -u postgres psql -X -v ON_ERROR_STOP=1 "
                f"-d {shlex.quote(DB_NAME)} "
                f"-c {shlex.quote(public_schema_owner_sql(DB_USER))}",
            )
            emit_step("drop_recreate_db", "success", "Database recreated")
        except subprocess.CalledProcessError as e:
            emit_step("drop_recreate_db", "failure", f"Failed to drop/recreate database: {e.stderr}")
            emit_result(success=False, error=f"Failed to drop/recreate database: {e.stderr}")
            finish_stdout("failure", "Database drop/recreate failed")
            return 1

        # pg_restore (--exit-on-error: fail immediately on any error, safe since
        # we're restoring into a freshly created database with no conflicts)
        emit_step("restore_database", "running", "Restoring database from dump")
        try:
            ssh(
                RESTORE_HOST,
                REMOTE_USER,
                f"sudo -u postgres pg_restore --exit-on-error --dbname={shlex.quote(DB_NAME)} --no-owner --role={shlex.quote(DB_USER)} {shlex.quote(remote_dump_path)}",
            )
            emit_step("restore_database", "success", "Database restored")
        except subprocess.CalledProcessError as e:
            emit_step("restore_database", "failure", f"pg_restore failed: {e.stderr}")
            emit_result(success=False, error=f"pg_restore failed: {e.stderr}")
            finish_stdout("failure", "Database restore failed")
            return 1

        # Swap private media into place while the service is still stopped
        if private_media_restore is not None:
            emit_step("restore_private_media", "running", f"Installing private media at {private_media_target}")
            try:
                script = install_private_media_script(
                    remote_private_media_path,
                    private_media_restore[1],
                    private_media_target,
                    private_media_owner,
                )
                ssh(RESTORE_HOST, REMOTE_USER, f"sh -c {shlex.quote(script)}")
                emit_step("restore_private_media", "success", "Private media restored")
            except subprocess.CalledProcessError as e:
                emit_step("restore_private_media", "failure", f"Private media restore failed: {_process_error(e)}")
                emit_result(success=False, error=f"Private media restore failed: {_process_error(e)}")
                finish_stdout("failure", "Private media restore failed")
                return 1

        # Start service and auxiliary units again, in the order they were stopped.
        # Units are only dropped from stopped_services once actually started, so
        # the finally block retries whatever is left behind.
        emit_step("start_service", "running", f"Starting {', '.join(stopped_services)}")
        try:
            while stopped_services:
                ssh(RESTORE_HOST, REMOTE_USER, f"systemctl start {shlex.quote(stopped_services[0])}")
                stopped_services.pop(0)
            emit_step("start_service", "success", f"Started {', '.join(restore_units)}")
        except subprocess.CalledProcessError as e:
            emit_step("start_service", "failure", f"Failed to start service: {e.stderr}")
            emit_result(success=False, error=f"Restore succeeded but service start failed: {e.stderr}")
            finish_stdout("failure", "Service start failed")
            return 1

        # Post-check: SQL connectivity
        emit_step("post_check", "running", "Verifying database connectivity")
        try:
            ssh(
                RESTORE_HOST,
                REMOTE_USER,
                f"sudo -u postgres psql -d {shlex.quote(DB_NAME)} -c 'SELECT 1'",
            )
            emit_step("post_check", "success", "Database connectivity verified")
        except subprocess.CalledProcessError as e:
            emit_step("post_check", "failure", f"Post-check failed: {e.stderr}")
            emit_result(success=False, error=f"Post-check failed: {e.stderr}")
            finish_stdout("failure", "Post-check failed")
            return 1

        restore_success = True
        result_data = {
            "bucket": bucket,
            "key": key,
            "size_bytes": tarball_path.stat().st_size,
            "checksum_sha256": actual_checksum,
            "file_count": 2 if private_media_restore is not None else 1,
        }

    except Exception as e:
        print(f"Restore failed with error: {e}", file=sys.stderr)
        emit_step("error", "failure", str(e))
        emit_result(success=False, error=str(e))
        finish_stdout("failure", f"Unexpected error: {e}")
        return 1
    finally:
        # Best-effort restart of anything still stopped
        if stopped_services:
            emit_step("start_service", "running", f"Best-effort restart of {', '.join(stopped_services)}")
            for unit in list(stopped_services):
                try:
                    ssh(RESTORE_HOST, REMOTE_USER, f"systemctl start {shlex.quote(unit)}")
                    stopped_services.remove(unit)
                    emit_step("start_service", "success", f"Started {unit}")
                except subprocess.CalledProcessError as e:
                    emit_step("start_service", "failure", f"Failed to restart {unit}: {e.stderr}")

        # Clean up remote dump and private media archive
        emit_step("cleanup", "running", "Cleaning up temporary files")
        cleanup_ok = True
        try:
            result = ssh(RESTORE_HOST, REMOTE_USER, f"rm -f {shlex.quote(remote_dump_path)}", check=False)
            if result.returncode != 0:
                print(f"[WARN] Remote cleanup returned non-zero: {result.stderr}", file=sys.stderr)
                cleanup_ok = False
        except Exception as e:
            print(f"[WARN] Remote cleanup failed: {e}", file=sys.stderr)
            cleanup_ok = False
        if not remove_remote_private_dirs(RESTORE_HOST, REMOTE_USER, remote_private_dirs):
            cleanup_ok = False

        # Clean up local temp directory
        shutil.rmtree(work_dir, ignore_errors=True)

        if cleanup_ok:
            emit_step("cleanup", "success", "Temporary files cleaned")
        else:
            emit_step("cleanup", "success", "Temporary files cleaned (remote cleanup warning)")

        # Emit final result
        if restore_success:
            emit_result(success=True, **result_data)
            finish_stdout("success", "Restore completed successfully")
            return 0

    return 1  # Should not reach here, but return failure as safety


def main() -> int:
    """Main entry point - dispatch to backup or restore."""
    # Read configuration to determine action
    config = read_config_file()

    if config:
        context = config.get("context", {})
    else:
        # Fallback for manual testing (non-production)
        print("Warning: No config file found, using environment (testing mode)", file=sys.stderr)
        context_raw = os.environ.get("CONTEXT", "{}")
        try:
            context = json.loads(context_raw)
        except json.JSONDecodeError:
            context = {}

    cenv = context.get("env", {})
    action = cenv.get("ECHOPORT_ACTION", "backup")
    bucket = cenv.get("ECHOPORT_BUCKET", DEFAULT_BUCKET)
    # Note: ECHOPORT_DB_PATH is ignored for PostgreSQL targets. Database name,
    # user, and service are locked to Ansible-templated defaults above.

    print(f"Configuration:", file=sys.stderr)
    print(f"  Action: {action}", file=sys.stderr)
    print(f"  Backup Host: {BACKUP_HOST}", file=sys.stderr)
    print(f"  Restore Host: {RESTORE_HOST}", file=sys.stderr)
    print(f"  Remote User: {REMOTE_USER}", file=sys.stderr)
    print(f"  Database: {DB_NAME}", file=sys.stderr)
    print(f"  DB User: {DB_USER}", file=sys.stderr)
    print(f"  Service: {SERVICE_NAME}", file=sys.stderr)
    print(f"  Bucket: {bucket}", file=sys.stderr)
    print(f"  Private media path: {PRIVATE_MEDIA_PATH or '(disabled)'}", file=sys.stderr)

    if action == "restore":
        # Opt-in only via the Ansible-locked default or a manual CLI flag;
        # nothing in the Echoport context can switch it on.
        include_private_media = RESTORE_PRIVATE_MEDIA_DEFAULT or INCLUDE_PRIVATE_MEDIA_FLAG in sys.argv
        key = cenv.get("ECHOPORT_KEY", "")
        expected_checksum = cenv.get("ECHOPORT_CHECKSUM", "")

        if not key:
            error_msg = "No storage key provided for restore"
            emit_step("init", "failure", error_msg)
            emit_result(success=False, error=error_msg)
            finish_stdout("failure", error_msg)
            return 1

        if not expected_checksum:
            error_msg = "No checksum provided for restore - cannot verify backup integrity"
            emit_step("init", "failure", error_msg)
            emit_result(success=False, error=error_msg)
            finish_stdout("failure", error_msg)
            return 1

        print(f"  Key: {key}", file=sys.stderr)
        print(f"  Checksum: {expected_checksum}", file=sys.stderr)
        print(f"  Restore private media: {include_private_media}", file=sys.stderr)

        return restore(
            bucket=bucket,
            key=key,
            expected_checksum=expected_checksum,
            include_private_media=include_private_media,
        )
    else:
        timestamp = cenv.get("ECHOPORT_TIMESTAMP", datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%S"))
        key_prefix = cenv.get("ECHOPORT_KEY_PREFIX", "")

        if not key_prefix:
            key_prefix = f"python-podcast-production-db/{timestamp}"

        print(f"  Key Prefix: {key_prefix}", file=sys.stderr)
        print(f"  Timestamp: {timestamp}", file=sys.stderr)

        return backup(
            bucket=bucket,
            key_prefix=key_prefix,
            timestamp=timestamp,
        )


if __name__ == "__main__":
    # Script runs as deploy user (has SSH access to production/staging via deploy key)

    try:
        sys.exit(main())
    except Exception as e:
        print(f"Backup/restore failed with error: {e}", file=sys.stderr)
        emit_step("error", "failure", str(e))
        emit_result(success=False, error=str(e))
        finish_stdout("failure", f"Unexpected error: {e}")
        sys.exit(1)
