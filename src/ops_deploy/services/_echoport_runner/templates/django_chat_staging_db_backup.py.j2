#!/usr/bin/env python3
"""
Django Chat staging database runner for Echoport (target `django-chat-staging-db`).

Runs on macmini as the deploy user and reaches the staging host as root over
SSH with the deploy key:
- Backup: `pg_dump --format=custom` of the Django Chat database on the staging
  host, streamed to macmini, checked with `pg_restore --list` for the tables
  the site needs, plus a manifest with row counts (read from the dump) and a
  checksum manifest, uploaded to MinIO as one tarball.
- Restore: download, verify both checksums and the dump, copy it to the
  staging host and restore it into a NEW scratch database
  `<prefix>_<restore id>` there. The live database is never touched; the row
  counts of the scratch database are compared with the manifest. Putting the
  data back into the live database is a documented, attended step (ops-control
  docs/DJANGO_CHAT_STAGING_DB_BACKUP.md).

Media is not in this archive: Django Chat keeps its media, including the
private voice references, in S3.

Fail-closed: a failed dump, an empty dump, a dump without one of the required
tables or a failed upload check fails the run, and nothing is reported as a
success.
"""

import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, Optional

os.environ["PYTHONUNBUFFERED"] = "1"

MC_PATH = "{{ echoport_backup_mc_install_path }}"
MINIO_ALIAS = "{{ echoport_backup_minio_alias }}"
DEFAULT_BUCKET = "{{ echoport_backup_default_bucket }}"
# Per-run work dirs live on the external encrypted disk only (fail closed, see
# _work_dir.py.j2): no fallback to /tmp, / or the system temp dir.
WORK_DIR = "{{ django_chat_staging_db_backup_work_dir | default('/mnt/cryptdata/backups/tmp/django-chat-staging-db-backup') }}"
WORK_MOUNT = "{{ django_chat_staging_db_backup_work_mount | default('/mnt/cryptdata') }}"
WORK_RETENTION_HOURS = max(1, {{ django_chat_staging_db_backup_work_retention_hours | default(24) | int(24) }})
RUN_DIR_PREFIXES = ("django_chat_db_backup_", "django_chat_db_restore_")
# The runner runs as the deploy user (no sudo to root): WORK_DIR must belong
# to that user. ops-control provisions it (register-django-chat-staging-db-backup.yml).
WORK_OWNER_UID = os.geteuid()
WORK_OWNER_LABEL = "the runner user"

DB_HOST = "{{ django_chat_staging_db_backup_host }}"
REMOTE_USER = "{{ django_chat_staging_db_backup_remote_user }}"
DB_NAME = "{{ django_chat_staging_db_backup_db_name }}"
POSTGRES_OS_USER = "{{ django_chat_staging_db_backup_postgres_os_user }}"
RESTORE_DB_PREFIX = "{{ django_chat_staging_db_backup_restore_db_prefix }}"
REQUIRED_TABLES = [item for item in "{{ django_chat_staging_db_backup_required_tables | join(',') }}".split(",") if item]
COUNTED_TABLES = [item for item in "{{ django_chat_staging_db_backup_counted_tables | join(',') }}".split(",") if item]

SSH_OPTS = ["-o", "StrictHostKeyChecking=yes", "-o", "BatchMode=yes", "-o", "ConnectTimeout=30"]
MANIFEST_FORMAT_VERSION = 1
# Database names may carry a hyphen (`django-chat`); table and scratch
# database names may not.
DB_NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]*$")
IDENTIFIER_RE = re.compile(r"^[a-z_][a-z0-9_]*$")
SSH_IDENTIFIER_RE = re.compile(r"^[a-zA-Z0-9._-]+$")
REMOTE_TEMP_PREFIX = "/var/tmp/django-chat-db-restore."
REMOTE_TEMP_RE = re.compile(r"^/var/tmp/django-chat-db-restore\.[A-Za-z0-9]+$")
DUMP_NAME = "django-chat.dump"


def read_config_file() -> Optional[Dict]:
    config_file = os.environ.get("DEPLOY_CONFIG_FILE")
    if "--config" in sys.argv:
        idx = sys.argv.index("--config")
        if idx + 1 < len(sys.argv):
            config_file = sys.argv[idx + 1]
    if not config_file or not Path(config_file).exists():
        return None
    try:
        with open(config_file, "r") as handle:
            return json.load(handle)
    except Exception:
        return None


def _emit(obj: Dict) -> None:
    print(json.dumps(obj, ensure_ascii=False), flush=True)


def emit_step(name: str, state: str, message: str = "") -> None:
    payload = {"name": name, "state": state}
    if message:
        payload["message"] = message
    _emit(payload)


def emit_result(
    success: bool,
    bucket: str = "",
    key: str = "",
    size_bytes: int = 0,
    checksum_sha256: str = "",
    file_count: int = 0,
    error: str | None = None,
) -> None:
    result = {
        "success": success,
        "bucket": bucket,
        "key": key,
        "size_bytes": size_bytes,
        "checksum_sha256": checksum_sha256,
        "file_count": file_count,
    }
    if error:
        result["error"] = error
    emit_step("result", "success" if success else "failure", f"ECHOPORT_RESULT:{json.dumps(result)}")


def finish_stdout(status: str, message: str = "") -> None:
    payload = {"event": "finish", "status": status}
    if message:
        payload["message"] = message
    _emit(payload)


def safe_error(exc: Exception) -> str:
    if isinstance(exc, subprocess.CalledProcessError):
        stderr = (exc.stderr or "").strip() if isinstance(exc.stderr, str) else ""
        stdout = (exc.stdout or "").strip() if isinstance(exc.stdout, str) else ""
        if stderr:
            return stderr
        if stdout:
            return stdout
        return f"Command failed with exit code {exc.returncode}"
    return str(exc)


def run_cmd(args: list[str], check: bool = True, stdin_path: Path | None = None,
            stdout_path: Path | None = None) -> subprocess.CompletedProcess:
    """Run a command (no shell); stdin/stdout can be local files."""
    stdin = open(stdin_path, "rb") if stdin_path else subprocess.DEVNULL
    stdout = open(stdout_path, "wb") if stdout_path else subprocess.PIPE
    try:
        result = subprocess.run(args, stdin=stdin, stdout=stdout, stderr=subprocess.PIPE)
    finally:
        if stdin_path:
            stdin.close()
        if stdout_path:
            stdout.close()
    out = result.stdout.decode("utf-8", "replace") if result.stdout is not None else ""
    err = result.stderr.decode("utf-8", "replace") if result.stderr is not None else ""
    completed = subprocess.CompletedProcess(args, result.returncode, out, err)
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, args, out, err)
    return completed


def ssh_args(remote_cmd: str) -> list[str]:
    """The ssh argv that runs one shell command line on the database host."""
    return ["ssh", *SSH_OPTS, f"{REMOTE_USER}@{DB_HOST}", remote_cmd]


def remote(args: list[str], check: bool = True, stdin_path: Path | None = None,
           stdout_path: Path | None = None, stdin_to: str | None = None) -> subprocess.CompletedProcess:
    """Run argv on the database host; every argument is shell-quoted there.

    `stdin_to` names a remote file the command reads as its stdin.
    """
    remote_cmd = shlex.join(args)
    if stdin_to is not None:
        remote_cmd += f" < {shlex.quote(stdin_to)}"
    return run_cmd(ssh_args(remote_cmd), check=check, stdin_path=stdin_path, stdout_path=stdout_path)


def as_postgres(args: list[str]) -> list[str]:
    """Run a PostgreSQL client as the database host's superuser (peer authentication)."""
    return ["runuser", "-u", POSTGRES_OS_USER, "--"] + args


def psql_value(sql: str, database: str) -> str:
    result = remote(as_postgres(["psql", "-X", "-v", "ON_ERROR_STOP=1", "-qAt", "-d", database, "-c", sql]))
    return result.stdout.strip()


def calculate_sha256(filepath: Path) -> str:
    sha256_hash = hashlib.sha256()
    with open(filepath, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            sha256_hash.update(chunk)
    return sha256_hash.hexdigest()


def validate_settings() -> None:
    if not DB_NAME_RE.fullmatch(DB_NAME):
        raise ValueError(f"Invalid db name: {DB_NAME!r}")
    if not IDENTIFIER_RE.fullmatch(RESTORE_DB_PREFIX):
        raise ValueError(f"Invalid restore db prefix: {RESTORE_DB_PREFIX!r}")
    for name, value in (("db host", DB_HOST), ("remote user", REMOTE_USER), ("postgres os user", POSTGRES_OS_USER)):
        if not SSH_IDENTIFIER_RE.fullmatch(value):
            raise ValueError(f"Invalid {name}: {value!r}")
    if not REQUIRED_TABLES:
        raise ValueError("No required tables configured")
    for table in REQUIRED_TABLES + COUNTED_TABLES:
        if not IDENTIFIER_RE.fullmatch(table):
            raise ValueError(f"Invalid table name: {table!r}")


def ensure_binaries() -> None:
    for binary in ["ssh", "pg_restore"]:
        if shutil.which(binary) is None:
            raise FileNotFoundError(f"Required binary not found in PATH: {binary}")
    if not Path(MC_PATH).exists():
        raise FileNotFoundError(f"Required binary not found: {MC_PATH}")


def dump_tables(dump_path: Path) -> set[str]:
    """Tables with data in the dump, from `pg_restore --list` (no connection)."""
    listing = run_cmd(["pg_restore", "--list", str(dump_path)]).stdout
    tables = set()
    for line in listing.splitlines():
        match = re.search(r"\bTABLE DATA (\S+) (\S+) ", line)
        if match and match.group(1) == "public":
            tables.add(match.group(2))
    return tables


def check_dump(dump_path: Path) -> list[str]:
    if not dump_path.is_file() or dump_path.stat().st_size == 0:
        raise RuntimeError("pg_dump produced no output")
    tables = dump_tables(dump_path)
    missing = [t for t in REQUIRED_TABLES if t not in tables]
    if missing:
        raise RuntimeError(f"Dump lacks required tables: {', '.join(missing)}")
    return sorted(tables)


def dump_row_counts(dump_path: Path) -> Dict[str, int]:
    """Row counts of the counted tables as they are in the dump.

    Read from the dump itself (one COPY line per row), so they match the
    snapshot pg_dump took even when the site writes while it runs.
    """
    counts = {}
    for table in COUNTED_TABLES:
        output = run_cmd(
            ["pg_restore", "--data-only", "--schema=public", f"--table={table}", "--file=-", str(dump_path)]
        ).stdout
        rows = None
        # COPY ends rows with \n only; splitlines() would also split on
        # U+2028, U+0085 and the like inside a value.
        for line in output.split("\n"):
            if rows is None:
                if line.startswith(f"COPY public.{table} ") and line.endswith("FROM stdin;"):
                    rows = 0
            elif line == "\\.":
                break
            else:
                rows += 1
        if rows is None:
            raise RuntimeError(f"No data section for table {table} in the dump")
        counts[table] = rows
    return counts


def row_counts(database: str) -> Dict[str, int]:
    counts = {}
    for table in COUNTED_TABLES:
        value = psql_value(f"SELECT count(*) FROM public.{table};", database)
        counts[table] = int(value)
    return counts


def make_checksum_manifest(root_dir: Path, manifest_path: Path) -> None:
    lines = []
    for path in sorted(p for p in root_dir.rglob("*") if p.is_file() and p != manifest_path):
        lines.append(f"{calculate_sha256(path)}  ./{path.relative_to(root_dir).as_posix()}")
    manifest_path.write_text("\n".join(lines) + "\n")


def verify_checksum_manifest(root_dir: Path, manifest_path: Path) -> None:
    if not manifest_path.is_file():
        raise FileNotFoundError("manifest.sha256 missing from backup archive")
    for line in (line.strip() for line in manifest_path.read_text().splitlines()):
        if not line:
            continue
        parts = line.split("  ", 1)
        if len(parts) != 2:
            raise ValueError(f"Invalid checksum manifest line: {line}")
        expected, rel_path = parts
        target = root_dir / (rel_path[2:] if rel_path.startswith("./") else rel_path)
        if not target.is_file():
            raise FileNotFoundError(f"Checksum target missing: {rel_path}")
        if calculate_sha256(target) != expected:
            raise ValueError(f"Checksum mismatch for {rel_path}")


def create_tarball(source_dir: Path, tarball_path: Path) -> None:
    with tarfile.open(tarball_path, "w:gz") as tar:
        for item in sorted(source_dir.iterdir(), key=lambda p: p.name):
            tar.add(item, arcname=item.name)


def safe_extract_tarball(tarball_path: Path, extract_dir: Path) -> None:
    """Extract regular files and directories only, never outside extract_dir."""
    root = extract_dir.resolve()
    with tarfile.open(tarball_path, "r:gz") as tar:
        members = tar.getmembers()
        for member in members:
            if not (member.isfile() or member.isdir()):
                raise ValueError(f"Tarball member is not a regular file or directory: {member.name}")
            target = (extract_dir / member.name).resolve()
            if member.name.startswith("/") or ".." in Path(member.name).parts or not (
                target == root or root in target.parents
            ):
                raise ValueError(f"Tarball member escapes extraction root: {member.name}")
        tar.extractall(extract_dir, members=members)


