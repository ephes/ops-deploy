def work_directory(prefix: str) -> Path:
    # Fail closed: the run dir is created 0700 below WORK_DIR on WORK_MOUNT.
    # A refusal is reported by the flow's error handler, before any dump,
    # download or remote command.
    try:
        return create_run_dir(prefix)
    except Exception as exc:
        raise RuntimeError(f"Work directory check failed: {exc}") from exc


def backup_flow(cenv: Dict) -> int:
    emit_step("init", "running", "Validating backup configuration")
    target_name = cenv.get("ECHOPORT_TARGET", "django-chat-staging-db")
    run_id = cenv.get("ECHOPORT_RUN_ID", "0")
    bucket = cenv.get("ECHOPORT_BUCKET", DEFAULT_BUCKET)
    key_prefix = cenv.get(
        "ECHOPORT_KEY_PREFIX",
        f"{target_name}/{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H-%M-%S')}",
    )
    work_dir: Path | None = None
    try:
        validate_settings()
        ensure_binaries()
        emit_step("init", "success", f"Configuration loaded for {target_name} run {run_id}")
        work_dir = work_directory("django_chat_db_backup_")
        payload = work_dir / "payload"
        payload.mkdir()

        emit_step("dump_database", "running", f"Dumping database {DB_NAME} on {DB_HOST}")
        dump_path = payload / DUMP_NAME
        remote(as_postgres(["pg_dump", "--format=custom", f"--dbname={DB_NAME}"]), stdout_path=dump_path)
        tables = check_dump(dump_path)
        counts = dump_row_counts(dump_path)
        server_version = psql_value("SHOW server_version;", DB_NAME)
        emit_step("dump_database", "success", f"Dumped {len(tables)} tables, {dump_path.stat().st_size} bytes")

        manifest = {
            "format_version": MANIFEST_FORMAT_VERSION,
            "target": target_name,
            "run_id": run_id,
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "host": DB_HOST,
            "database": DB_NAME,
            "dump": {"file": DUMP_NAME, "format": "custom", "sha256": calculate_sha256(dump_path)},
            "server_version": server_version,
            "tables": tables,
            "row_counts": counts,
        }
        (payload / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True))
        make_checksum_manifest(payload, payload / "manifest.sha256")

        emit_step("upload", "running", "Creating archive and uploading")
        tarball_path = work_dir / "backup.tar.gz"
        create_tarball(payload, tarball_path)
        checksum = calculate_sha256(tarball_path)
        storage_key = f"{key_prefix}.tar.gz"
        run_cmd([MC_PATH, "cp", "--quiet", str(tarball_path), f"{MINIO_ALIAS}/{bucket}/{storage_key}"])
        emit_step("upload", "success", f"Uploaded {storage_key}")

        emit_step("verify", "running", "Verifying object in MinIO")
        stat = json.loads(run_cmd([MC_PATH, "stat", "--json", f"{MINIO_ALIAS}/{bucket}/{storage_key}"]).stdout)
        if int(stat.get("size", -1)) != tarball_path.stat().st_size:
            raise RuntimeError(
                f"Uploaded size {stat.get('size')} differs from local size {tarball_path.stat().st_size}"
            )
        emit_step("verify", "success", "MinIO object verified")

        emit_result(
            success=True,
            bucket=bucket,
            key=storage_key,
            size_bytes=tarball_path.stat().st_size,
            checksum_sha256=checksum,
            file_count=sum(1 for p in payload.rglob("*") if p.is_file()),
        )
        finish_stdout("success", f"Backup completed: {storage_key}")
        return 0
    except Exception as exc:
        msg = safe_error(exc)
        emit_step("error", "failure", msg)
        emit_result(False, error=msg)
        finish_stdout("failure", f"Backup failed: {msg}")
        return 1
    finally:
        if work_dir is not None:
            shutil.rmtree(work_dir, ignore_errors=True)


def make_remote_temp_dir() -> str:
    path = remote(["mktemp", "-d", f"{REMOTE_TEMP_PREFIX}XXXXXXXX"]).stdout.strip()
    if not REMOTE_TEMP_RE.fullmatch(path):
        raise RuntimeError(f"Unexpected remote temp directory: {path!r}")
    return path


def remove_remote_temp_dir(path: str) -> None:
    if REMOTE_TEMP_RE.fullmatch(path):
        remote(["rm", "-rf", "--", path], check=False)


def restore_flow(cenv: Dict) -> int:
    emit_step("init", "running", "Validating restore configuration")
    restore_id = str(cenv.get("ECHOPORT_RESTORE_ID", ""))
    bucket = cenv.get("ECHOPORT_BUCKET", DEFAULT_BUCKET)
    storage_key = cenv.get("ECHOPORT_KEY", "")
    expected_checksum = cenv.get("ECHOPORT_CHECKSUM", "")
    work_dir: Path | None = None
    remote_dir = ""
    try:
        validate_settings()
        if not storage_key or not expected_checksum:
            raise RuntimeError("ECHOPORT_KEY and ECHOPORT_CHECKSUM are required for a restore")
        if not re.fullmatch(r"[0-9]+", restore_id):
            raise RuntimeError(f"ECHOPORT_RESTORE_ID must be numeric, got {restore_id!r}")
        scratch_db = f"{RESTORE_DB_PREFIX}_{restore_id}"
        if scratch_db == DB_NAME or not IDENTIFIER_RE.fullmatch(scratch_db):
            raise RuntimeError(f"Refusing scratch database name {scratch_db!r}")
        ensure_binaries()
        emit_step("init", "success", f"Restoring into scratch database {scratch_db} on {DB_HOST}; {DB_NAME} is not touched")
        work_dir = work_directory("django_chat_db_restore_")

        emit_step("download", "running", "Downloading archive from MinIO")
        tarball_path = work_dir / "backup.tar.gz"
        run_cmd([MC_PATH, "cp", "--quiet", f"{MINIO_ALIAS}/{bucket}/{storage_key}", str(tarball_path)])
        emit_step("download", "success", f"Downloaded {storage_key}")

        emit_step("verify_checksum", "running", "Verifying archive checksum")
        actual_checksum = calculate_sha256(tarball_path)
        if actual_checksum != expected_checksum:
            raise RuntimeError(f"Checksum mismatch: expected {expected_checksum}, got {actual_checksum}")
        emit_step("verify_checksum", "success", "Archive checksum verified")

        emit_step("extract", "running", "Extracting and validating archive")
        extract_dir = work_dir / "extract"
        extract_dir.mkdir()
        safe_extract_tarball(tarball_path, extract_dir)
        verify_checksum_manifest(extract_dir, extract_dir / "manifest.sha256")
        manifest = json.loads((extract_dir / "manifest.json").read_text())
        dump_path = extract_dir / DUMP_NAME
        if manifest.get("dump", {}).get("file") != DUMP_NAME:
            raise RuntimeError("manifest.json does not name the dump")
        check_dump(dump_path)
        emit_step("extract", "success", "Archive and dump validated")

        emit_step("restore_database", "running", f"Restoring into {scratch_db} on {DB_HOST}")
        exists = psql_value(f"SELECT 1 FROM pg_database WHERE datname = '{scratch_db}';", "postgres")
        if exists:
            raise RuntimeError(f"Scratch database {scratch_db} already exists; drop it or use a new restore")
        remote_dir = make_remote_temp_dir()
        remote_dump = f"{remote_dir}/{DUMP_NAME}"
        # mktemp -d creates the directory 0700 for root; the dump (password
        # hashes, sessions) stays unreadable to everyone else there.
        run_cmd(ssh_args(f"umask 077 && cat > {shlex.quote(remote_dump)}"), stdin_path=dump_path)
        if remote(["sha256sum", remote_dump]).stdout.split()[:1] != [calculate_sha256(dump_path)]:
            raise RuntimeError("The dump copied to the database host differs from the archive")
        remote(as_postgres(["createdb", scratch_db]))
        remote(
            as_postgres(["pg_restore", "--no-owner", "--no-privileges", "--exit-on-error", f"--dbname={scratch_db}"]),
            stdin_to=remote_dump,
        )
        emit_step("restore_database", "success", f"Restored into {scratch_db}")

        emit_step("verify_restore", "running", "Comparing row counts with the manifest")
        expected_counts = manifest.get("row_counts", {})
        # Every counted table needs an expected count: an archive without one
        # (older, or with a shorter table list) cannot prove the restore.
        unrecorded = [table for table in COUNTED_TABLES if not isinstance(expected_counts.get(table), int)]
        if unrecorded:
            raise RuntimeError(f"manifest.json has no row count for: {', '.join(unrecorded)}")
        actual_counts = row_counts(scratch_db)
        mismatched = {
            table: (expected_counts[table], actual)
            for table, actual in actual_counts.items()
            if expected_counts[table] != actual
        }
        if mismatched:
            raise RuntimeError(f"Row counts differ from the manifest: {mismatched}")
        emit_step("verify_restore", "success", f"Row counts match: {actual_counts}")

        emit_result(
            success=True,
            bucket=bucket,
            key=storage_key,
            size_bytes=tarball_path.stat().st_size,
            checksum_sha256=actual_checksum,
            file_count=sum(1 for p in extract_dir.rglob("*") if p.is_file()),
        )
        finish_stdout("success", f"Restored into scratch database {scratch_db} on {DB_HOST}; {DB_NAME} unchanged")
        return 0
    except Exception as exc:
        msg = safe_error(exc)
        emit_step("error", "failure", msg)
        emit_result(False, error=msg)
        finish_stdout("failure", f"Restore failed: {msg}")
        return 1
    finally:
        if remote_dir:
            remove_remote_temp_dir(remote_dir)
        if work_dir is not None:
            shutil.rmtree(work_dir, ignore_errors=True)


def main() -> int:
    config = read_config_file()
    if config:
        context = config.get("context", {})
    else:
        context = json.loads(os.environ.get("CONTEXT", "{}"))
    cenv = context.get("env", {})
    if cenv.get("ECHOPORT_ACTION", "backup") == "restore":
        return restore_flow(cenv)
    return backup_flow(cenv)


if __name__ == "__main__":
    # Runs as the deploy user: its SSH key reaches the staging host as root,
    # and its mc configuration holds this target's MinIO alias.
    try:
        sys.exit(main())
    except Exception as exc:
        msg = safe_error(exc)
        emit_step("error", "failure", msg)
        emit_result(False, error=msg)
        finish_stdout("failure", f"Unexpected error: {msg}")
        sys.exit(1)
