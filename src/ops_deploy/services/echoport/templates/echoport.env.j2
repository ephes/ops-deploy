# Echoport environment configuration
# Managed by Ansible - do not edit manually

# Django settings
DJANGO_SETTINGS_MODULE={{ echoport_django_settings_module }}
SECRET_KEY={{ echoport_django_secret_key }}
ALLOWED_HOSTS={{ echoport_django_allowed_hosts }}
DJANGO_DEBUG={{ echoport_django_debug | lower }}

# FastDeploy integration
FASTDEPLOY_BASE_URL={{ echoport_fastdeploy_base_url }}
FASTDEPLOY_SERVICE_TOKEN={{ echoport_fastdeploy_service_token }}

# Application settings
APP_HOST={{ echoport_app_host }}
APP_PORT={{ echoport_app_port }}

# MinIO retention cleanup (mc alias configured for {{ echoport_user }})
MINIO_MC_PATH={{ echoport_minio_mc_path }}
MINIO_ALIAS={{ echoport_minio_alias }}

# Paths
ECHOPORT_CACHE_DIR={{ echoport_cache_dir }}
ECHOPORT_ALLOWED_PATH_PREFIXES={{ echoport_allowed_path_prefixes | join(',') }}
{% if echoport_stale_run_grace_seconds | string | length > 0 %}
ECHOPORT_STALE_RUN_GRACE_SECONDS={{ echoport_stale_run_grace_seconds | int }}
{% endif %}
{% if echoport_late_result_window_seconds | string | length > 0 %}
ECHOPORT_LATE_RESULT_WINDOW_SECONDS={{ echoport_late_result_window_seconds | int }}
{% endif %}
{% if echoport_health_overdue_grace_minutes | string | length > 0 %}
ECHOPORT_HEALTH_OVERDUE_GRACE_MINUTES={{ echoport_health_overdue_grace_minutes | int }}
{% endif %}
