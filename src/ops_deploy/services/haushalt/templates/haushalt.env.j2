# haushalt environment - managed by ops-deploy (haushalt service), do not edit
DJANGO_SETTINGS_MODULE=site_config.settings
DJANGO_SECRET_KEY={{ secret_key }}
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS={{ allowed_hosts }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins }}
HAUSHALT_DATABASE_PATH={{ cfg.database_path }}
DJANGO_STATIC_ROOT={{ cfg.static_root }}
HAUSHALT_UPLOAD_TOKEN_SHA256={{ upload_token_sha256 }}
