{
  "version": 1,
  "protocolVersion": 1,
  "targets": [
    {
      "type": "auth-profiles.api_key.key",
      "path": "profiles.{{ openclaw_audio_transcription_profile_id }}.key",
      "pathSegments": [
        "profiles",
        {{ openclaw_audio_transcription_profile_id | to_json }},
        "key"
      ],
      "agentId": "main",
      "authProfileProvider": {{ openclaw_audio_transcription_provider | to_json }},
      "ref": {
        "source": "env",
        "provider": "default",
        "id": {{ openclaw_audio_transcription_api_key_env | to_json }}
      }
    }
  ],
  "options": {
    "scrubEnv": false,
    "scrubAuthProfilesForProviderTargets": false
  }
}
