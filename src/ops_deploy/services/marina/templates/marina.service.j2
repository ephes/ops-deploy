[Unit]
Description=Marina web application
After=network.target

[Service]
Type=simple
Restart=always
WorkingDirectory={{ cfg.site_path }}
User={{ cfg.user }}
Environment="DJANGO_SETTINGS_MODULE={{ cfg.django_settings_module }}"
ExecStart={{ cfg.site_path }}/gunicorn.sh
{% if cfg.systemd_hardening %}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths={{ cfg.site_path }} {{ cfg.cache_dir }}
{% endif %}

[Install]
WantedBy=multi-user.target
