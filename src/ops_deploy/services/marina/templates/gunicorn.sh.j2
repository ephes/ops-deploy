#!/bin/bash
set -euo pipefail

cd {{ cfg.site_path }}
{{ cfg.venv_bin }}/gunicorn \
  -w {{ cfg.gunicorn_workers }} \
  --access-logfile - \
  --error-logfile - \
  --access-logformat '%({x-forwarded-for}i)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s"' \
  -b 127.0.0.1:{{ cfg.app_port }} \
  -t {{ cfg.gunicorn_timeout }} \
  config.wsgi
