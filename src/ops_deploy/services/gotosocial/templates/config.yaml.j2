# Managed by Ansible (ops-library gotosocial_deploy) - do not edit by hand.
# Keys: https://docs.gotosocial.org/en/latest/configuration/
{% set settings = {
  'log-level': gotosocial_log_level,
  'log-client-ip': gotosocial_log_client_ip | bool,
  'application-name': gotosocial_application_name,
  'landing-page-user': gotosocial_landing_page_user,
  'host': gotosocial_host,
  'account-domain': gotosocial_account_domain,
  'protocol': 'https',
  'bind-address': gotosocial_bind_address,
  'port': gotosocial_port | int,
  'trusted-proxies': gotosocial_trusted_proxies,
  'db-type': 'sqlite',
  'db-address': gotosocial_db_path,
  'db-sqlite-journal-mode': 'WAL',
  'db-sqlite-synchronous': 'NORMAL',
  'cache': {'memory-target': gotosocial_cache_memory_target},
  'web-template-base-dir': gotosocial_current_link ~ '/web/template/',
  'web-asset-base-dir': gotosocial_current_link ~ '/web/assets/',
  'instance-languages': gotosocial_instance_languages,
  'instance-expose-public-timeline': gotosocial_instance_expose_public_timeline | bool,
  'instance-robots-allow-indexing': gotosocial_instance_robots_allow_indexing | bool,
  'accounts-registration-open': gotosocial_accounts_registration_open | bool,
  'media-remote-cache-duration': gotosocial_media_remote_cache_duration,
  'storage-backend': 'local',
  'storage-local-base-path': gotosocial_storage_dir,
  'letsencrypt-enabled': false,
  'smtp-host': gotosocial_smtp_host,
  'smtp-port': gotosocial_smtp_port | int,
  'smtp-username': gotosocial_smtp_username,
  'smtp-password': gotosocial_smtp_password,
  'smtp-from': gotosocial_smtp_from,
} %}
{{ settings | combine(gotosocial_extra_config, recursive=True) | to_nice_yaml(indent=2, sort_keys=True) }}
