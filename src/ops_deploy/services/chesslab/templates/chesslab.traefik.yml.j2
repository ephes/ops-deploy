# Managed by Ansible - Chesslab Traefik configuration

http:
  routers:
{% if route.basic_auth %}
    chesslab-int:
      rule: "Host(`{{ route.host }}`) && ({% for range in route.internal_ip_ranges %}ClientIP(`{{ range }}`){{ ' || ' if not loop.last else '' }}{% endfor %})"
      entryPoints:
        - web-secure
      priority: 120
      middlewares:
        - chesslab-headers
        - chesslab-gzip
{% for middleware in route.middlewares %}
        - {{ middleware }}
{% endfor %}
      service: chesslab
{% if route.cert_resolver %}
      tls:
        certResolver: {{ route.cert_resolver }}
{% else %}
      tls: {}
{% endif %}

    chesslab-ext:
      rule: "Host(`{{ route.host }}`)"
      entryPoints:
        - web-secure
      priority: 100
      middlewares:
        - chesslab-auth
        - chesslab-headers
        - chesslab-gzip
{% for middleware in route.middlewares %}
        - {{ middleware }}
{% endfor %}
      service: chesslab
{% if route.cert_resolver %}
      tls:
        certResolver: {{ route.cert_resolver }}
{% else %}
      tls: {}
{% endif %}
{% else %}
    chesslab-secure:
      rule: "Host(`{{ route.host }}`)"
      entryPoints:
        - web-secure
      middlewares:
        - chesslab-headers
        - chesslab-gzip
{% for middleware in route.middlewares %}
        - {{ middleware }}
{% endfor %}
      service: chesslab
{% if route.cert_resolver %}
      tls:
        certResolver: {{ route.cert_resolver }}
{% else %}
      tls: {}
{% endif %}
{% endif %}

    chesslab-http:
      rule: "Host(`{{ route.host }}`)"
      entryPoints:
        - web
      middlewares:
        - chesslab-redirect
      service: chesslab

  middlewares:
{% if route.basic_auth %}
    chesslab-auth:
      basicAuth:
        users:
          - "{{ route.basic_auth.user }}:{{ auth_hash }}"
        removeHeader: true
{% endif %}

    chesslab-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsSeconds: 15552000
        # The backend answers X-Frame-Options: DENY itself. Traefik replaces
        # the backend's header with this value, so it must not be weaker.
        customFrameOptionsValue: DENY
        customRequestHeaders:
          X-Forwarded-Proto: https
          X-Forwarded-Host: "{{ route.host }}"

    chesslab-gzip:
      compress: {}

    chesslab-redirect:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    chesslab:
      loadBalancer:
        servers:
          - url: "http://{{ route.app_host }}:{{ route.app_port }}"
