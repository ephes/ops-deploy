# Postfix local-delivery clients (cidr table)
# Generated by Ansible - do not edit manually
# Role: mail_backend_deploy (mail_backend_local_delivery_clients)
#
# Port 25 (master.cf smtp/inet) checks the client here after
# permit_mynetworks. A match applies the restriction class
# local_delivery_only (main.cf): hosted recipients only, no relaying.
{% for client in mail_backend_local_delivery_clients %}
{{ client }} local_delivery_only
{% endfor %}
