#
# File mail the spam filter marked as spam into the Junk mailbox. Runs before
# each user's own sieve script (sieve_before).
require ["fileinto", "mailbox"];

if anyof (
  header :matches "X-Spam-Status" "Yes,*",
  header :is "X-Spam" "Yes"
) {
  fileinto :create "{{ mail_backend_spam_junk_mailbox }}";
  stop;
}
