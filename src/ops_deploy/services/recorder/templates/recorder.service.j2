# Managed by Ansible (recorder_deploy). Do not edit on the host.
[Unit]
Description=Recorder application backend (recorderd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ cfg.user }}
Group={{ cfg.user }}
WorkingDirectory={{ cfg.data_dir }}
EnvironmentFile={{ cfg.env_path }}
ExecStart={{ cfg.bin_path }}
Restart=always
RestartSec=5s
LimitNOFILE={{ cfg.systemd_nofile }}

# Hardening — the service writes only under its data dir (SQLite + scratch).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ cfg.data_dir }}
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
