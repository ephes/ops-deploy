<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>{{ opsgate_api_launchd_label | e }}</string>

{# opsgate_launchd_render_impl: set by the template task; python renders the
    venv command of opsgate_api_program(_arguments), rust the pinned release
    binary in the same login-shell wrapper (rust/PLAN.md 10.1 of the opsgate
    repository). #}
{% set opsgate_plist_impl = opsgate_launchd_render_impl | default(opsgate_api_impl) %}
    <key>ProgramArguments</key>
    <array>
{% if opsgate_plist_impl == 'rust' %}
      <string>/usr/bin/env</string>
      <string>bash</string>
      <string>-lc</string>
      <string>{{ ('cd ' ~ (opsgate_app_dir | quote) ~ ' && exec ' ~ (opsgate_rust_binary | quote) ~ ' serve') | e }}</string>
{% else %}
      <string>{{ opsgate_api_program | e }}</string>
{% for arg in opsgate_api_program_arguments %}
      <string>{{ arg | e }}</string>
{% endfor %}
{% endif %}
    </array>

    <key>EnvironmentVariables</key>
    <dict>
{% for key, value in opsgate_api_environment | dictsort %}
      <key>{{ key | e }}</key>
      <string>{{ value | e }}</string>
{% endfor %}
    </dict>

    <key>UserName</key>
    <string>{{ control_service_user | e }}</string>
    <key>GroupName</key>
    <string>{{ control_service_group | e }}</string>
    <key>WorkingDirectory</key>
    <string>{{ opsgate_api_working_directory | e }}</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
{% if opsgate_launchd_keepalive | bool %}
    <true/>
{% else %}
    <false/>
{% endif %}

    <key>StandardOutPath</key>
    <string>{{ opsgate_api_stdout_log | e }}</string>
    <key>StandardErrorPath</key>
    <string>{{ opsgate_api_stderr_log | e }}</string>
  </dict>
</plist>
