{% for name in opsgate_ops_github_deploy_keys | sort %}
Host github-{{ name }}
  HostName github.com
  HostKeyAlias github.com
  User git
  IdentityFile {{ opsgate_ops_github_deploy_key_path_prefix }}{{ name }}
  IdentitiesOnly yes
{% endfor %}
{% if opsgate_ops_github_ssh_private_key | trim | length > 0 %}
Host github.com
  HostName github.com
  User git
  IdentityFile {{ opsgate_ops_github_ssh_private_key_path }}
  IdentitiesOnly yes
{% endif %}
