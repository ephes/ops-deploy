[Unit]
Description=Nyxmon Monitoring Service
After=network.target nyxmon.service
Wants=network-online.target

[Service]
Type=exec
User={{ cfg.user }}
Group={{ cfg.user }}
WorkingDirectory={{ cfg.site_path }}
EnvironmentFile={{ cfg.env_path }}

ExecStart={{ cfg.agent_rust_binary }} --db {{ cfg.site_path }}/db.sqlite3 --enable-telegram

Restart=always
RestartSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Need access to /home/nyxmon
ProtectHome=false
ReadWritePaths={{ cfg.home }} {{ cfg.cache_dir }}

[Install]
WantedBy=multi-user.target
