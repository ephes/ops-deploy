{#- Byte-identical to the nyxmon_deploy role's nyxmon.env.j2 output (tests/test_nyxmon_parity.py). -#}
{% macro q(value) -%}{% if shell %}"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% else %}{{ value }}{% endif %}{%- endmacro -%}
# Nyxmon environment configuration
# Managed by Ansible - do not edit manually

# Django settings
DJANGO_SETTINGS_MODULE={{ q(cfg.django_settings_module) }}
DJANGO_SECRET_KEY={{ q(secrets["django_secret_key"]) }}
DJANGO_ALLOWED_HOSTS={{ q(cfg.django_allowed_hosts) }}
DJANGO_CACHE_LOCATION={{ q(cfg.cache_dir) }}
DJANGO_ADMIN_URL={{ q(cfg.django_admin_url) }}
DJANGO_DEBUG={{ q(cfg.django_debug | string | lower) }}
NYXBOARD_REQUIRE_LOGIN={{ q(cfg.require_login | string | lower) }}


# Telegram settings
TELEGRAM_BOT_TOKEN={{ q(secrets["telegram_bot_token"]) }}
TELEGRAM_CHAT_ID={{ q(secrets["telegram_chat_id"]) }}

# Monitoring reliability
NYXMON_NOTIFY_CONSECUTIVE_FAILURES={{ q(cfg.notify_consecutive_failures) }}
NYXMON_NOTIFY_REPEAT_INTERVAL_SECONDS={{ q(cfg.notify_repeat_interval_seconds) }}
NYXMON_NOTIFY_WARNING_REPEAT_INTERVAL_SECONDS={{ q(cfg.notify_warning_repeat_interval_seconds) }}
NYXMON_PROCESSING_LEASE_SECONDS={{ q(cfg.processing_lease_seconds) }}
NYXMON_CHECK_BATCH_SIZE={{ q(cfg.check_batch_size) }}
{% if cfg.opsgate_enabled %}
# OpsGate producer integration (optional)
OPSGATE_SUBMIT_BASE_URL={{ q(cfg.opsgate_submit_base_url) }}
OPSGATE_SUBMIT_TOKEN={{ q(secrets["opsgate_submit_token"]) }}
OPSGATE_APPROVAL_BASE_URL={{ q(cfg.opsgate_approval_url) }}
OPSGATE_TICKET_EXPIRES_SECONDS={{ q(cfg.opsgate_ticket_expires_seconds) }}
OPSGATE_SUBMIT_TIMEOUT_SECONDS={{ q(cfg.opsgate_submit_timeout_seconds) }}
OPSGATE_SUBMIT_INCLUDE_WARNINGS={{ q(cfg.opsgate_submit_include_warnings | string | lower) }}
{% endif %}
# Application settings
APP_HOST={{ q(cfg.app_host) }}
APP_PORT={{ q(cfg.app_port) }}
