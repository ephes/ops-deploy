{% import "_edge.j2" as edge -%}
http:
  routers:
    unifi:
      rule: "Host(`{{ unifi_external_hostname }}`)"
      entryPoints:
{% for entrypoint in unifi_traefik_entrypoints %}
        - "{{ entrypoint }}"
{% endfor %}
      service: unifi
      middlewares:
{% if unifi_traefik_ip_allowlist | length > 0 %}
        - unifi-ipallow
{% endif %}
        - unifi-edge-headers
{% if unifi_traefik_certresolver | default('') | length > 0 %}
      tls:
        certResolver: "{{ unifi_traefik_certresolver }}"
{% else %}
      tls: {}
{% endif %}

  middlewares:
{% if unifi_traefik_ip_allowlist | length > 0 %}
    unifi-ipallow:
      ipAllowList:
        sourceRange:
{% for cidr in unifi_traefik_ip_allowlist %}
          - "{{ cidr }}"
{% endfor %}
{% endif %}
    unifi-edge-headers:
      headers:
        customRequestHeaders:
{{- edge.request_headers(10) }}

  services:
    unifi:
      loadBalancer:
        servers:
          - url: "https://{{ unifi_controller_bind_address }}:{{ unifi_port_https }}"
        serversTransport: unifi-transport

  serversTransports:
    unifi-transport:
      insecureSkipVerify: true
