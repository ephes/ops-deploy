{#- Byte-identical to the fastdeploy_deploy role's fastdeploy.env.j2 output (tests/test_fastdeploy_parity.py). -#}
{% macro q(value) -%}{% if shell %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% else %}{{ value }}{% endif %}{%- endmacro -%}
# FastDeploy Environment Configuration
# Managed by Ansible - do not edit manually

DEPLOY_ENV={{ q(cfg.environment) }}
PATH_FOR_DEPLOY={{ q(cfg.venv_bin ~ ':/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin') }}
SERVICES_ROOT={{ q(cfg.services_path) }}
SUDO_USER={{ cfg.deploy_user }}

# API Configuration
API_URL={{ q(cfg.api_url) }}

# Database Configuration
DATABASE_URL={{ q('postgresql+asyncpg://' ~ cfg.postgres_user ~ ':' ~ secrets["postgres_password"] ~ '@' ~ cfg.postgres_host ~ ':' ~ cfg.postgres_port ~ '/' ~ cfg.postgres_database) }}

# Security
SECRET_KEY={{ q(secrets["secret_key"]) }}
{%- if cfg.service_token_settings %}

# Service tokens
{%- endif %}
{%- if cfg.legacy_service_tokens_accepted_until %}
LEGACY_SERVICE_TOKENS_ACCEPTED_UNTIL={{ q(cfg.legacy_service_tokens_accepted_until | replace(' ', 'T')) }}
{%- endif %}
{%- if cfg.service_token_max_expire_days is not none %}
SERVICE_TOKEN_MAX_EXPIRE_DAYS={{ q(cfg.service_token_max_expire_days) }}
{%- endif %}
{%- if cfg.service_token_retention_days is not none %}
SERVICE_TOKEN_RETENTION_DAYS={{ q(cfg.service_token_retention_days) }}
{%- endif %}
