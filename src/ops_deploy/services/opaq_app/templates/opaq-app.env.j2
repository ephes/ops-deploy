# Opaq app environment - managed by Ansible, do not edit
DJANGO_SETTINGS_MODULE=opaq_app.settings
DJANGO_SECRET_KEY={{ secret_key }}
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS={{ allowed_hosts }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins }}
OPAQ_DATABASE_PATH={{ cfg.database_path }}
DJANGO_STATIC_ROOT={{ cfg.static_root }}
OPAQ_UPLOAD_TOKEN_SHA256={{ upload_token_sha256 }}
PYTHONPATH={{ cfg.site_path }}/src:{{ cfg.app_dir }}
