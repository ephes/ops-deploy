# Opaq app - managed by Ansible, do not edit.
# The tailnet allowlist is the first barrier, the Django login the second.
http:
  routers:
    opaq-app-secure:
      rule: "Host(`{{ cfg.traefik_host }}`)"
      entryPoints:
        - {{ cfg.traefik_entrypoint }}
      middlewares:
        - opaq-app-allowlist
      service: opaq-app
      tls: {}
    opaq-app-http:
      rule: "Host(`{{ cfg.traefik_host }}`)"
      entryPoints:
        - {{ cfg.traefik_http_entrypoint }}
      middlewares:
        - opaq-app-allowlist
        - opaq-app-redirect
      service: noop@internal

  middlewares:
    opaq-app-allowlist:
      ipAllowList:
        sourceRange: {{ allowed_networks_json }}
    opaq-app-redirect:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    opaq-app:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://{{ cfg.app_host }}:{{ cfg.app_port }}"
