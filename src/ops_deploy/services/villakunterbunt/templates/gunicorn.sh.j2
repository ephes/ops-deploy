#!/bin/bash
set -euo pipefail
set -a; source {{ cfg.env_path }}; set +a
cd {{ cfg.django_path }}
exec {{ cfg.venv_bin }}/gunicorn \
    -w {{ cfg.gunicorn_workers }} \
    --access-logfile - --error-logfile - \
    --access-logformat '%({x-forwarded-for}i)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s"' \
    -b 127.0.0.1:{{ cfg.django_port }} -t 3600 \
    config.wsgi
