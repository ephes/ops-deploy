# FastDeploy Environment Configuration
# Managed by Ansible - do not edit manually

DEPLOY_ENV=production
PATH_FOR_DEPLOY=/home/fastdeploy/site/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SERVICES_ROOT=/home/fastdeploy/site/services
SUDO_USER=deploy

# API Configuration
API_URL=https://deploy.example.com

# Database Configuration
DATABASE_URL=postgresql+asyncpg://fastdeploy:pg-fixture-password@localhost:5432/fastdeploy

# Security
SECRET_KEY=k$y`with"quotes\and(parens)&amp;#

# Service tokens
LEGACY_SERVICE_TOKENS_ACCEPTED_UNTIL=2026-10-31T00:00:00+00:00
SERVICE_TOKEN_ADMIN_USERS='["admin","ops@example.com"]'

# Restores
RESTORE_POLICIES='{"echoport-backup":{"bucket":"backups","prefixes":["nyxmon/","archive/"]},"weeknotes-home-backup":{"bucket":"backups","prefixes":["weeknotes_home/","weeknotes-home/"]}}'
