[Unit]
Description=FastDeploy Service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
User=fastdeploy
Group=fastdeploy
WorkingDirectory=/home/fastdeploy/site
Environment="PATH=/home/fastdeploy/site/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/fastdeploy/site/.env
ExecStart=/home/fastdeploy/site/.venv/bin/python -m uvicorn deploy.entrypoints.fastapi_app:app --port 9999 --host 127.0.0.1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5

# Security settings (simplified for compatibility)
# NoNewPrivileges disabled to allow subprocess to use sudo -u deploy
# The subprocess needs to switch from fastdeploy user to deploy user
NoNewPrivileges=false
# PrivateTmp disabled to allow subprocess with sudo to access config files
# The subprocess runs as 'deploy' user and needs to read config files created by 'fastdeploy' user
PrivateTmp=false

[Install]
WantedBy=multi-user.target