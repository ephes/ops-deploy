# Echoport environment configuration
# Managed by Ansible - do not edit manually

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=k$y`with"quotes\and(parens)&amp;#0123456789
ALLOWED_HOSTS=127.0.0.1,echoport.home.example.invalid
DJANGO_DEBUG=true

# FastDeploy integration
FASTDEPLOY_BASE_URL=https://deploy.example.invalid
FASTDEPLOY_SERVICE_TOKEN=token-0123456789abcdef

# Application settings
APP_HOST=127.0.0.1
APP_PORT=10018

# MinIO retention cleanup (mc alias configured for echoport)
MINIO_MC_PATH=/usr/local/bin/mc
MINIO_ALIAS=minio

# Paths
ECHOPORT_CACHE_DIR=/home/echoport/site/cache
ECHOPORT_ALLOWED_PATH_PREFIXES=/srv/
ECHOPORT_STALE_RUN_GRACE_SECONDS=600
ECHOPORT_LATE_RESULT_WINDOW_SECONDS=7200
ECHOPORT_HEALTH_OVERDUE_GRACE_MINUTES=90
