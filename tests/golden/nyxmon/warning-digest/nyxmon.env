# Nyxmon environment configuration
# Managed by Ansible - do not edit manually

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=k$y`with"quotes\and(parens)&amp;#
DJANGO_ALLOWED_HOSTS=127.0.0.1
DJANGO_CACHE_LOCATION=/home/nyxmon/site/cache
DJANGO_ADMIN_URL=admin/
DJANGO_DEBUG=false
NYXBOARD_REQUIRE_LOGIN=false


# Telegram settings
TELEGRAM_BOT_TOKEN=123456:fixture-bot-token
TELEGRAM_CHAT_ID=-100987654321

# Monitoring reliability
NYXMON_NOTIFY_CONSECUTIVE_FAILURES=2
NYXMON_NOTIFY_REPEAT_INTERVAL_SECONDS=21600
NYXMON_NOTIFY_WARNING_REPEAT_INTERVAL_SECONDS=86400
NYXMON_NOTIFY_WARNING_DELIVERY=digest
NYXMON_PROCESSING_LEASE_SECONDS=900
NYXMON_CHECK_BATCH_SIZE=5

# Application settings
APP_HOST=127.0.0.1
APP_PORT=10017
