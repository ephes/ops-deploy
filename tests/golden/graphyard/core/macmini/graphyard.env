# Managed by Ansible (graphyard_deploy role). Do not edit manually.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=graphyard-fixture-django-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,graphyard.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,https://graphyard.example.invalid
DJANGO_ADMIN_URL=hidden_admin/
DJANGO_LOGIN_URL=/login/
DJANGO_LOGIN_REDIRECT_URL=/
DJANGO_SESSION_COOKIE_AGE_SECONDS=86400
GRAPHYARD_INVENTORY_MONITOR_TOKEN=graphyard-fixture-inventory-monitor-token-0123456789

INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=graphyard-fixture-influx-token
INFLUX_ORG=graphyard
INFLUX_BUCKET=graphyard
INFLUX_MEASUREMENT=graphyard_metrics
INFLUX_TIMEOUT_MS=10000
INFLUX_API_MODE=v2

GRAFANA_BASE_URL=https://grafana.example.invalid

GRAPHYARD_METRIC_COLLECTION_INTERVAL_SECONDS=60
GRAPHYARD_CONDITION_EVAL_INTERVAL_SECONDS=60
GRAPHYARD_INGEST_HEARTBEAT_MIN_INTERVAL_SECONDS=15

GRAPHYARD_HEARTBEAT_WARNING_SECONDS=900
GRAPHYARD_HEARTBEAT_CRITICAL_SECONDS=3600
GRAPHYARD_CONDITION_DATA_STALE_WARNING_SECONDS=600

GRAPHYARD_SQLITE_TIMEOUT_SECONDS=30
GRAPHYARD_SQLITE_BUSY_TIMEOUT_MS=30000
GRAPHYARD_SQLITE_JOURNAL_MODE=WAL
GRAPHYARD_SQLITE_SYNCHRONOUS=FULL
