# Managed by Ansible (delve_deploy). Do not edit on the host.
DELVE_ADDR="127.0.0.1:10099"
DELVE_DB_PATH="/srv/delve-data/delve.db"
DELVE_PUBLIC_URL="https://delve.example.com"
DELVE_SESSION_SECRET="x$y`z(parens)&#'-0123456789"
DELVE_DOGFOOD_TOKEN="t"
DELVE_APPLE_CLIENT_ID="org.example.player"
DELVE_APPLE_SERVER_NOTIFICATIONS="true"
DELVE_PROFILE_LEGACY_REREGISTER="false"
DELVE_APPLE_SIGNIN_LEGACY_NO_NONCE="false"
DELVE_DISCOVERY_POLL_INTERVAL_SECONDS="43200"
DELVE_DISCOVERY_POLL_JITTER_SECONDS="3600"
DELVE_DISCOVERY_EPISODE_TTL_SECONDS="7776000"
DELVE_DISCOVERY_MAX_ITEMS_PER_FEED="100"
DELVE_DISCOVERY_MAX_SOURCES_PER_RUN="100"
DELVE_ENV="staging"
DELVE_SMART_SKIP_ANALYSIS="true"
DELVE_SMART_SKIP_ANALYSIS_PROFILE="/srv/delve-etc/profile.json"
DELVE_ANALYSIS_MEDIA_DIR="/srv/delve-media"
DELVE_ANALYSIS_MEDIA_DISK_CAP_BYTES="5000000000"
DELVE_FFPROBE_PATH="/usr/local/bin/ffprobe"
DELVE_FFMPEG_PATH="/usr/local/bin/ffmpeg"
DELVE_VOXHELM_URL="https://voxhelm.example.org"
DELVE_VOXHELM_TOKEN_FILE="/srv/delve-etc/vox"
DELVE_VOXHELM_TIMEOUT_SECONDS="90"
DELVE_VOXHELM_UPLOAD_TIMEOUT_SECONDS="3600"
DELVE_VOXHELM_POLL_SECONDS="10"
DELVE_DETECTOR_URL="http://100.64.0.7:8177"
DELVE_DETECTOR_API_KEY_FILE="/srv/delve-etc/det"
DELVE_DETECTOR_TIMEOUT_SECONDS="600"
