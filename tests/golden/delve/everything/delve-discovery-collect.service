# Managed by Ansible (delve_deploy). Do not edit on the host.
[Unit]
Description=Delve Discovery reviewed RSS collector oneshot
Documentation=https://github.com/ephes/podcast
After=network-online.target delve-x.service
Wants=network-online.target

[Service]
Type=oneshot
User=dx
Group=dxg
WorkingDirectory=/srv/delve-data
EnvironmentFile=/srv/delve-etc/delve.env
ExecStart=/srv/delve/delved discovery collect --due --concurrency 8
TimeoutStartSec=35min

# Hardening — the collector writes only through the Delve SQLite DB under data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/delve-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
