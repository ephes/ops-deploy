# Managed by Ansible (delve_deploy). Do not edit on the host.
[Unit]
Description=Delve backend service (delved)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dx
Group=dxg
WorkingDirectory=/srv/delve-data
EnvironmentFile=/srv/delve-etc/delve.env
ExecStart=/srv/delve/delved
Restart=always
RestartSec=5s
LimitNOFILE=4096

# Hardening — the service writes only its SQLite database under the data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/delve-data
# Server ad analysis audio and transcripts (off the backup path).
ReadWritePaths=/srv/delve-media
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
