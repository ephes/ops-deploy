# Managed by Ansible (delve_deploy). Do not edit on the host.
[Unit]
Description=Delve backend service (delved)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=delve
Group=delve
WorkingDirectory=/var/lib/delve
EnvironmentFile=/etc/delve/delve.env
ExecStart=/opt/delve/delved
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Hardening — the service writes only its SQLite database under the data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/delve
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
