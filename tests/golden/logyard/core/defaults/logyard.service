[Unit]
Description=Logyard Loki (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/apps/logyard
ExecStart=/usr/bin/docker compose -f /opt/apps/logyard/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/apps/logyard/docker-compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
