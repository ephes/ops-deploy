# Managed by Ansible - MeTube environment
DOWNLOAD_DIR=/srv/metube/downloads
AUDIO_DOWNLOAD_DIR=/srv/metube/downloads
TEMP_DIR=/srv/metube/downloads
STATE_DIR=/var/lib/metube
OUTPUT_TEMPLATE=%(title)s [%(id)s].%(ext)s
HOST=127.0.0.1
PORT=8083
BASE_DIR=/opt/metube
DEFAULT_THEME=auto
MAX_CONCURRENT_DOWNLOADS=3
ENABLE_ACCESSLOG=false
LOGLEVEL=INFO
YTDL_OPTIONS={"merge_output_format": "mp4", "subtitles_langs": ["en"], "write_subs": true, "write_auto_subs": true}
PYTHONUNBUFFERED=1
