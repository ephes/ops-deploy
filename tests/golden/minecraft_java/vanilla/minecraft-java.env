# Minecraft Java Server Environment
# Generated by Ansible - minecraft_java_deploy role

# RCON password (used by systemd ExecStop and backup scripts)
RCON_PASSWORD=fixture-rcon-password
MCRCON_PASS=fixture-rcon-password

# Java memory settings (informational, actual settings in systemd)
MINECRAFT_MEMORY_MIN=2G
MINECRAFT_MEMORY_MAX=4G
