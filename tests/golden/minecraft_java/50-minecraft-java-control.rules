polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "homelab" &&
        action.lookup("unit") == "minecraft-java.service") {
        var verb = action.lookup("verb");
        var message = action.lookup("polkit.message");
        if ((verb === "start" && message === "Authentication is required to start '$(unit)'.") ||
            (verb === "stop" && message === "Authentication is required to stop '$(unit)'.")) {
            return polkit.Result.YES;
        }
    }
});
