[Unit]
Description=Run MinIO replication lag/parity monitor every 300 seconds

[Timer]
# OnActiveSec= re-anchors on every timer (re)start and OnCalendar= is the
# Persistent= wall-clock backstop, so a reboot cannot leave NEXT at n/a.
OnBootSec=120
OnActiveSec=120
OnUnitActiveSec=300
OnCalendar=*:0/5
AccuracySec=10
RandomizedDelaySec=20
Persistent=true

[Install]
WantedBy=timers.target
