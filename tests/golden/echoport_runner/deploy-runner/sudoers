# FastDeploy runner homepage-staging-backup (ops-library fastdeploy_runner).
# The script and every directory above it are root-owned; NOSETENV because
# FastDeploy passes the context in the --config file, not the environment.
fastdeploy ALL=(deploy) NOPASSWD:NOSETENV: /usr/local/libexec/fastdeploy/homepage-staging-backup/backup.py *
