{
    "gandi": {
        "api_base": "https://api.gandi.net/v5/livedns",
        "auth_scheme": "bearer"
    },
    "ip_sources": {
        "ipv4": "https://ipv4.icanhazip.com",
        "ipv6": "https://ipv6.icanhazip.com"
    },
    "ipv4": true,
    "ipv6": true,
    "log_file": "/var/log/ddns/ddns-update.log",
    "log_max_bytes": 10485760,
    "names": [
        "home",
        "*.home"
    ],
    "provider": "rfc2136",
    "providers": [
        "rfc2136"
    ],
    "rfc2136": {
        "key_algorithm": "hmac-sha256",
        "key_name": "ddns-home",
        "port": 53,
        "server": "127.0.0.1",
        "update_zone": "home.example.com"
    },
    "static_records": [],
    "status_path": "/var/lib/ddns/status.json",
    "ttl": 300,
    "verify_nameservers": [],
    "zone": "example.com"
}
