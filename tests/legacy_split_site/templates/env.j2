DJANGO_SETTINGS_MODULE={{ q(cfg.django_settings_module) }}
DJANGO_DEPLOY_ENVIRONMENT={{ q(cfg.deploy_environment) }}
DJANGO_SECRET_KEY={{ q(s.django_secret_key) }}
DJANGO_ALLOWED_HOSTS='{{ cfg.allowed_hosts }}'
DJANGO_CSRF_TRUSTED_ORIGINS='{{ cfg.csrf_trusted_origins }}'
DJANGO_CACHE_LOCATION='{{ cfg.cache_dir }}'
DJANGO_MEDIA_ROOT='{{ cfg.media_root }}'
DJANGO_PRIVATE_MEDIA_ROOT='{{ cfg.private_media_root }}'
DJANGO_HEALTHCHECK_FORCE_FAILURE_FILE='{{ cfg.healthcheck_force_failure_file }}'
DATABASE_ENGINE='django.db.backends.sqlite3'
DATABASE_NAME='{{ cfg.sqlite_path }}'
DJANGO_ADMIN_URL_PATH={{ q(s.django_admin_url_path) }}
WAGTAIL_ADMIN_URL_PATH={{ q(s.wagtail_admin_url_path) }}
WAGTAILADMIN_BASE_URL='https://{{ cfg.fqdn }}/{{ s.wagtail_admin_url_path.strip("/") }}'
DJANGO_EMAIL_BACKEND={{ q(email_backend) }}
MAILGUN_API_URL={{ q(s.mailgun_api_url) }}
MAILGUN_SENDER_DOMAIN={{ q(s.mailgun_sender_domain) }}
DJANGO_MAILGUN_API_KEY={{ q(s.django_mailgun_api_key) }}
DJANGO_DEFAULT_FROM_EMAIL={{ q(s.django_default_from_email) }}
DJANGO_SERVER_EMAIL={{ q(s.django_server_email) }}
DJANGO_EMAIL_SUBJECT_PREFIX={{ q(s.django_email_subject_prefix) }}
