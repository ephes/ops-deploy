{
  "os_apt_maintenance_enabled": true,
  "os_apt_maintenance_host_id": "{{ inventory_hostname }}",
  "os_apt_maintenance_state_dir": "/srv/apt-state",
  "os_apt_maintenance_state_file": "/srv/apt-state/custom.json",
  "os_apt_maintenance_lock_file": "/run/fixture-apt.lock",
  "os_apt_maintenance_script_path": "/usr/local/sbin/fixture-apt",
  "os_apt_maintenance_update_cache": false,
  "os_apt_maintenance_dist_upgrade": true,
  "os_apt_maintenance_autoremove": false,
  "os_apt_maintenance_autoclean": false,
  "os_apt_maintenance_auto_reboot": false,
  "os_apt_maintenance_apt_get_path": "/usr/bin/apt-get",
  "os_apt_maintenance_systemctl_path": "/usr/bin/systemctl",
  "os_apt_maintenance_command_timeout": 7200,
  "os_apt_maintenance_freshness_max_age_seconds": 1209600,
  "os_apt_maintenance_service_name": "os-apt-maintenance",
  "os_apt_maintenance_timer_on_calendar": "Mon *-*-* 03:15:00",
  "os_apt_maintenance_timer_randomized_delay_sec": "15m",
  "os_apt_maintenance_timer_accuracy_sec": "5m",
  "os_apt_maintenance_timer_persistent": false,
  "os_apt_maintenance_timer_enabled": true,
  "os_apt_maintenance_timer_state": "started",
  "os_apt_maintenance_run_on_deploy": false,
  "os_apt_maintenance_run_on_first_deploy": true,
  "os_apt_maintenance_refresh_enabled": true,
  "os_apt_maintenance_refresh_service_name": "os-apt-maintenance-refresh",
  "os_apt_maintenance_refresh_timer_on_calendar": "*-*-* 09:15:00",
  "os_apt_maintenance_refresh_timer_randomized_delay_sec": "20m",
  "os_apt_maintenance_refresh_timer_accuracy_sec": "2m",
  "os_apt_maintenance_refresh_timer_persistent": false,
  "os_apt_maintenance_refresh_timer_enabled": true,
  "os_apt_maintenance_refresh_timer_state": "started",
  "os_apt_maintenance_refresh_command_timeout": 900,
  "os_apt_maintenance_endpoint_enabled": true,
  "os_apt_maintenance_endpoint_user": "fixturemetrics",
  "os_apt_maintenance_endpoint_group": "{{ os_apt_maintenance_endpoint_user }}",
  "os_apt_maintenance_endpoint_service_name": "os-apt-maintenance-endpoint",
  "os_apt_maintenance_endpoint_impl": "{{ metrics_httpd_impl | default('python') }}",
  "os_apt_maintenance_endpoint_bind": "100.64.0.7",
  "os_apt_maintenance_endpoint_port": 19106,
  "os_apt_maintenance_endpoint_path": "/fixture/state",
  "os_apt_maintenance_endpoint_auth_user": "monitor",
  "os_apt_maintenance_endpoint_auth_password": "CHANGE_ME",
  "os_apt_maintenance_endpoint_server_path": "/usr/local/bin/fixture-http.py",
  "os_apt_maintenance_endpoint_htpasswd_dir": "/etc/fixture-apt",
  "os_apt_maintenance_endpoint_htpasswd_path": "{{ os_apt_maintenance_endpoint_htpasswd_dir }}/htpasswd",
  "os_apt_maintenance_endpoint_timeout": 10,
  "os_apt_maintenance_endpoint_state_max_age_seconds": 1296000,
  "os_apt_maintenance_endpoint_ip_allow": [
    "100.64.0.0/10",
    "192.0.2.0/24"
  ],
  "os_apt_maintenance_packages": [
    "python3"
  ],
  "os_apt_maintenance_endpoint_packages": [
    "python3",
    "apache2-utils"
  ],
  "inventory_hostname": "fixture-two"
}
