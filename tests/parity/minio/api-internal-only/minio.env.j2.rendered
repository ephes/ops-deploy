# MinIO environment configuration
# Managed by Ansible - do not edit manually

# Root credentials
MINIO_ROOT_USER="fixture-root"
MINIO_ROOT_PASSWORD="fixture-root-value"

# Data volumes
MINIO_VOLUMES="/srv/minio/one /srv/minio/two"

# MinIO options
MINIO_OPTS="-C /etc/minio --address 127.0.0.1:9001 --console-address 127.0.0.1:9002"

