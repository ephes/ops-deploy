# MinIO environment configuration
# Managed by Ansible - do not edit manually

# Root credentials
MINIO_ROOT_USER="fixture-root"
MINIO_ROOT_PASSWORD="fixture-root-value"

# Data volumes
MINIO_VOLUMES="/srv/minio/data"

# MinIO options
MINIO_OPTS="-C /etc/fixture-minio --address 127.0.0.1:19001 --console-address 127.0.0.1:19002 --certs-dir /etc/fixture-minio/certs"

# Server-side encryption
MINIO_KMS_SECRET_KEY="fixture-key:synthetic-only"
