// Managed by Ansible (bind_authoritative_deploy)
// If you are just adding zones, edit named.conf.local instead.

{# Keys first: nothing may reference a key before it is defined. Conditional
   because including a file that does not exist makes named refuse to start,
   and because omitting it keeps the output identical for keyless hosts. #}
{% if bind_tsig_keys | length > 0 %}
include "{{ bind_tsig_keys_file }}";
{% endif %}
include "{{ bind_config_dir }}/named.conf.options";
include "{{ bind_config_dir }}/named.conf.local";
include "{{ bind_builtin_zones_file }}";
