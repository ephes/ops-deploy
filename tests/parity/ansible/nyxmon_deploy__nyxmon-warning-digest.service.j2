[Unit]
Description=Nyxmon warning digest
After=network-online.target nyxmon.service
Wants=network-online.target
StartLimitIntervalSec=86400
StartLimitBurst=8

[Service]
Type=oneshot
User={{ nyxmon_user }}
Group={{ nyxmon_group }}
WorkingDirectory={{ nyxmon_django_path }}
EnvironmentFile={{ nyxmon_site_path }}/.env
UMask=0077

ExecStart={{ nyxmon_venv_bin }}/python manage.py send_warning_digest

# A failed delivery retries; the digest has no other way to reach the owner.
Restart=on-failure
RestartSec=900

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Need access to /home/nyxmon
ProtectHome=false
ReadWritePaths={{ nyxmon_home }} {{ nyxmon_cache_dir }}
