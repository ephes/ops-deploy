{# The systemd unit reads this file as written. With task_shell_environment the same
   values are rendered for the 0600 companion that management tasks source, with
   shell expansion characters escaped as well. #}
{% macro env_value(value) -%}
{%- set escaped = value | string | replace('\\', '\\\\') | replace('"', '\\"') -%}
{%- if task_shell_environment | default(false) -%}
{%- set escaped = escaped | replace('$', '\\$') | replace('`', '\\`') -%}
{%- endif -%}
"{{ escaped }}"
{%- endmacro %}
DJANGO_SETTINGS_MODULE={{ env_value(chesslab_django_settings_module) }}
CHESSLAB_SECRET_KEY={{ env_value(chesslab_django_secret_key) }}
CHESSLAB_DEBUG={{ env_value(chesslab_django_debug | lower) }}
CHESSLAB_DB_PATH={{ env_value(chesslab_db_path) }}
CHESSLAB_ALLOWED_HOSTS={{ env_value(chesslab_django_allowed_hosts | join(',')) }}
CHESSLAB_CSRF_TRUSTED_ORIGINS={{ env_value(chesslab_django_csrf_trusted_origins | join(',')) }}
CHESSLAB_SECURE_COOKIES={{ env_value(chesslab_secure_cookies | lower) }}
{% if chesslab_limit | string | length > 0 %}
CHESSLAB_TRAINER_LIMIT={{ env_value(chesslab_limit) }}
{% endif %}
