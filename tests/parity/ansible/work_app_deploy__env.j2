# Environment configuration for the work app
# This file is managed by Ansible - do not edit manually

DJANGO_SETTINGS_MODULE={{ work_app_django_settings_module }}
DJANGO_SECRET_KEY={{ work_app_secret_key }}
DJANGO_DEBUG={{ work_app_django_debug | lower }}
DJANGO_ALLOWED_HOSTS={{ work_app_django_allowed_hosts | join(',') }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ work_app_django_csrf_trusted_origins | join(',') }}
DJANGO_ADMIN_URL={{ work_app_django_admin_url }}

# Database (SQLite)
DATABASE_URL=sqlite:///{{ work_app_database_path }}

# Static files (served by WhiteNoise)
DJANGO_STATIC_ROOT={{ work_app_static_root }}

# Traefik terminates TLS; disable the redirect so local health checks work
DJANGO_SECURE_SSL_REDIRECT=False

# Relative evidence paths from the YAML ledger become links here
LEDGER_EVIDENCE_BASE_URL={{ work_app_evidence_base_url }}
