# Managed by Ansible - weeknotes.home environment
{# The systemd unit reads this file as written. With task_shell_environment the same
   values are rendered for the 0600 companion that management tasks source, with
   shell expansion characters escaped as well. #}
{% macro env_value(value) -%}
{%- set escaped = value | string | replace('\\', '\\\\') | replace('"', '\\"') -%}
{%- if task_shell_environment | default(false) -%}
{%- set escaped = escaped | replace('$', '\\$') | replace('`', '\\`') -%}
{%- endif -%}
"{{ escaped }}"
{%- endmacro %}
DJANGO_SETTINGS_MODULE={{ env_value(weeknotes_home_django_settings_module) }}
DJANGO_SECRET_KEY={{ env_value(weeknotes_home_django_secret_key) }}
DJANGO_DEBUG={{ env_value(weeknotes_home_django_debug | lower) }}
DJANGO_ALLOWED_HOSTS={{ env_value(weeknotes_home_django_allowed_hosts | join(',')) }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ env_value(weeknotes_home_django_csrf_trusted_origins | join(',')) }}
DJANGO_STATIC_ROOT={{ env_value(weeknotes_home_static_root) }}
DJANGO_DB_CONN_MAX_AGE={{ env_value(weeknotes_home_django_db_conn_max_age) }}
WEEKNOTES_HOME_CAST_BASE_URL={{ env_value(weeknotes_home_cast_base_url) }}
WEEKNOTES_HOME_API_TOKEN={{ env_value(weeknotes_home_api_token) }}
DATABASE_URL={{ env_value(weeknotes_home_database_url) }}
