# Managed by Ansible (delve_deploy). Do not edit on the host.
DELVE_ADDR="{{ delve_listen_address }}:{{ delve_port }}"
DELVE_DB_PATH="{{ delve_data_dir }}/delve.db"
DELVE_PUBLIC_URL="{{ delve_public_url }}"
DELVE_SESSION_SECRET="{{ delve_session_secret }}"
{% if delve_admin_emails | length > 0 %}
DELVE_ADMIN_EMAILS="{{ delve_admin_emails }}"
{% endif %}
{% if delve_dogfood_token | length > 0 %}
DELVE_DOGFOOD_TOKEN="{{ delve_dogfood_token }}"
{% endif %}
{% if delve_apple_client_id | length > 0 %}
DELVE_APPLE_CLIENT_ID="{{ delve_apple_client_id }}"
{% endif %}
{% if delve_apple_server_notifications | string | length > 0 %}
DELVE_APPLE_SERVER_NOTIFICATIONS="{{ delve_apple_server_notifications | bool | lower }}"
{% endif %}
{% if delve_profile_legacy_reregister | string | length > 0 %}
DELVE_PROFILE_LEGACY_REREGISTER="{{ delve_profile_legacy_reregister | bool | lower }}"
{% endif %}
{% if delve_apple_signin_legacy_no_nonce | string | length > 0 %}
DELVE_APPLE_SIGNIN_LEGACY_NO_NONCE="{{ delve_apple_signin_legacy_no_nonce | bool | lower }}"
{% endif %}
{% if delve_storekit_root_certs_path | length > 0 %}
DELVE_STOREKIT_ROOT_CERTS="{{ delve_storekit_root_certs_path }}"
DELVE_STOREKIT_BUNDLE_ID="{{ delve_storekit_bundle_id }}"
DELVE_STOREKIT_PRODUCT_IDS="{{ delve_storekit_product_ids }}"
{% endif %}
DELVE_DISCOVERY_POLL_INTERVAL_SECONDS="{{ delve_discovery_poll_interval_seconds }}"
DELVE_DISCOVERY_POLL_JITTER_SECONDS="{{ delve_discovery_poll_jitter_seconds }}"
DELVE_DISCOVERY_EPISODE_TTL_SECONDS="{{ delve_discovery_episode_ttl_seconds }}"
DELVE_DISCOVERY_MAX_ITEMS_PER_FEED="{{ delve_discovery_max_items_per_feed }}"
DELVE_DISCOVERY_MAX_SOURCES_PER_RUN="{{ delve_discovery_max_sources_per_run }}"
{% if delve_env | length > 0 %}
DELVE_ENV="{{ delve_env }}"
{% endif %}
{% if delve_smart_skip_analysis | bool %}
DELVE_SMART_SKIP_ANALYSIS="true"
DELVE_SMART_SKIP_ANALYSIS_PROFILE="{{ delve_smart_skip_analysis_profile_path }}"
{% if delve_analysis_media_dir | length > 0 %}
DELVE_ANALYSIS_MEDIA_DIR="{{ delve_analysis_media_dir }}"
{% endif %}
{% if delve_analysis_media_disk_cap_bytes | string | length > 0 %}
DELVE_ANALYSIS_MEDIA_DISK_CAP_BYTES="{{ delve_analysis_media_disk_cap_bytes | int }}"
{% endif %}
{% if delve_ffprobe_path | length > 0 %}
DELVE_FFPROBE_PATH="{{ delve_ffprobe_path }}"
{% endif %}
{% if delve_ffmpeg_path | length > 0 %}
DELVE_FFMPEG_PATH="{{ delve_ffmpeg_path }}"
{% endif %}
{% if delve_voxhelm_url | length > 0 %}
DELVE_VOXHELM_URL="{{ delve_voxhelm_url }}"
DELVE_VOXHELM_TOKEN_FILE="{{ delve_voxhelm_token_path }}"
{% endif %}
{% if delve_voxhelm_timeout_seconds | string | length > 0 %}
DELVE_VOXHELM_TIMEOUT_SECONDS="{{ delve_voxhelm_timeout_seconds | int }}"
{% endif %}
{% if delve_voxhelm_upload_timeout_seconds | string | length > 0 %}
DELVE_VOXHELM_UPLOAD_TIMEOUT_SECONDS="{{ delve_voxhelm_upload_timeout_seconds | int }}"
{% endif %}
{% if delve_voxhelm_poll_seconds | string | length > 0 %}
DELVE_VOXHELM_POLL_SECONDS="{{ delve_voxhelm_poll_seconds | int }}"
{% endif %}
{% if delve_detector_url | length > 0 %}
DELVE_DETECTOR_URL="{{ delve_detector_url }}"
DELVE_DETECTOR_API_KEY_FILE="{{ delve_detector_api_key_path }}"
{% endif %}
{% if delve_detector_timeout_seconds | string | length > 0 %}
DELVE_DETECTOR_TIMEOUT_SECONDS="{{ delve_detector_timeout_seconds | int }}"
{% endif %}
{% endif %}
