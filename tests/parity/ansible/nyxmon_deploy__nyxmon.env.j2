{# Keep the application format; quote only the management-command companion. #}
{% macro env_value(value) -%}{% if task_shell_environment | default(false) %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% else %}{{ value }}{% endif %}{%- endmacro %}
# Nyxmon environment configuration
# Managed by Ansible - do not edit manually

# Django settings
DJANGO_SETTINGS_MODULE={{ env_value((nyxmon_django_settings_module)) }}
DJANGO_SECRET_KEY={{ env_value((nyxmon_django_secret_key)) }}
DJANGO_ALLOWED_HOSTS={{ env_value((nyxmon_django_allowed_hosts)) }}
DJANGO_CACHE_LOCATION={{ env_value((nyxmon_cache_dir)) }}
DJANGO_ADMIN_URL={{ env_value((nyxmon_django_admin_url)) }}
DJANGO_DEBUG={{ env_value((nyxmon_django_debug | lower)) }}
NYXBOARD_REQUIRE_LOGIN={{ env_value((nyxmon_require_login | bool | lower)) }}


# Telegram settings
TELEGRAM_BOT_TOKEN={{ env_value((nyxmon_telegram_bot_token)) }}
TELEGRAM_CHAT_ID={{ env_value((nyxmon_telegram_chat_id)) }}

# Monitoring reliability
NYXMON_NOTIFY_CONSECUTIVE_FAILURES={{ env_value((nyxmon_notify_consecutive_failures)) }}
NYXMON_NOTIFY_REPEAT_INTERVAL_SECONDS={{ env_value((nyxmon_notify_repeat_interval_seconds)) }}
NYXMON_NOTIFY_WARNING_REPEAT_INTERVAL_SECONDS={{ env_value((nyxmon_notify_warning_repeat_interval_seconds)) }}
NYXMON_PROCESSING_LEASE_SECONDS={{ env_value((nyxmon_processing_lease_seconds)) }}
NYXMON_CHECK_BATCH_SIZE={{ env_value((nyxmon_check_batch_size)) }}
{% if nyxmon_opsgate_submit_base_url | trim | length > 0 and nyxmon_opsgate_submit_token | trim | length > 0 %}

# OpsGate producer integration (optional)
OPSGATE_SUBMIT_BASE_URL={{ env_value((nyxmon_opsgate_submit_base_url)) }}
OPSGATE_SUBMIT_TOKEN={{ env_value((nyxmon_opsgate_submit_token)) }}
OPSGATE_APPROVAL_BASE_URL={{ env_value((nyxmon_opsgate_approval_base_url)) }}
OPSGATE_TICKET_EXPIRES_SECONDS={{ env_value((nyxmon_opsgate_ticket_expires_seconds)) }}
OPSGATE_SUBMIT_TIMEOUT_SECONDS={{ env_value((nyxmon_opsgate_submit_timeout_seconds)) }}
OPSGATE_SUBMIT_INCLUDE_WARNINGS={{ env_value((nyxmon_opsgate_submit_include_warnings | lower)) }}
{% endif %}

# Application settings
APP_HOST={{ env_value((nyxmon_app_host)) }}
APP_PORT={{ env_value((nyxmon_app_port)) }}
