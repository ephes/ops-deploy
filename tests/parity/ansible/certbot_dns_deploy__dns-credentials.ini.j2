# DNS provider credentials for Certbot (managed by Ansible)

{% if certbot_dns_provider == "gandi" %}
# Gandi LiveDNS API key
dns_gandi_api_key = {{ certbot_dns_gandi_api_token }}
{% elif certbot_dns_provider == "rfc2136" %}
# RFC 2136 DNS UPDATE, authenticated with TSIG
dns_rfc2136_server = {{ certbot_dns_rfc2136_server }}
dns_rfc2136_port = {{ certbot_dns_rfc2136_port }}
dns_rfc2136_name = {{ certbot_dns_rfc2136_key_name }}
dns_rfc2136_secret = {{ certbot_dns_rfc2136_key_secret }}
dns_rfc2136_algorithm = {{ certbot_dns_rfc2136_key_algorithm | upper }}
{% endif %}
