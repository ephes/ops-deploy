{# Keep the application format; quote only the management-command companion. #}
{% macro env_value(value) -%}{% if task_shell_environment | default(false) %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% else %}{{ value }}{% endif %}{%- endmacro %}
# FastDeploy Environment Configuration
# Managed by Ansible - do not edit manually

DEPLOY_ENV={{ env_value((fastdeploy_environment)) }}
PATH_FOR_DEPLOY={{ env_value((fastdeploy_venv_bin) ~ ':/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin') }}
SERVICES_ROOT={{ env_value((fastdeploy_services_path)) }}
SUDO_USER=deploy

# API Configuration
API_URL={{ env_value((fastdeploy_api_url)) }}

# Database Configuration
DATABASE_URL={{ env_value('postgresql+asyncpg://' ~ (fastdeploy_postgres_user) ~ ':' ~ (fastdeploy_postgres_password) ~ '@' ~ (fastdeploy_postgres_host) ~ ':' ~ (fastdeploy_postgres_port) ~ '/' ~ (fastdeploy_postgres_database)) }}

# Security
SECRET_KEY={{ env_value((fastdeploy_secret_key)) }}
{% if fastdeploy_legacy_service_tokens_accepted_until | string | length > 0 or fastdeploy_service_token_max_expire_days | string | length > 0 or fastdeploy_service_token_retention_days | string | length > 0 %}

# Service tokens
{% endif %}
{% if fastdeploy_legacy_service_tokens_accepted_until | string | length > 0 %}
LEGACY_SERVICE_TOKENS_ACCEPTED_UNTIL={{ env_value((fastdeploy_legacy_service_tokens_accepted_until | string | replace(' ', 'T'))) }}
{% endif %}
{% if fastdeploy_service_token_max_expire_days | string | length > 0 %}
SERVICE_TOKEN_MAX_EXPIRE_DAYS={{ env_value((fastdeploy_service_token_max_expire_days)) }}
{% endif %}
{% if fastdeploy_service_token_retention_days | string | length > 0 %}
SERVICE_TOKEN_RETENTION_DAYS={{ env_value((fastdeploy_service_token_retention_days)) }}
{% endif %}
