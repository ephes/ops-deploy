# Managed by ops-library software_live (software_live_impl: rust).
# Runs the pinned Rust release instead of the base unit's Python program;
# removing this file (and daemon-reload, restart) switches back to Python.
[Service]
ExecStart=
ExecStart=/usr/local/lib/fixture-software-live/releases/0.1.2/software-live serve --config /etc/fixture-software-live/endpoint.json
