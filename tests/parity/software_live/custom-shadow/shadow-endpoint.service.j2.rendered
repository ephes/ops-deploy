[Unit]
Description=Authenticated software health JSON endpoint (Rust shadow, loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=observer
Group=observer
ExecStart=/usr/local/lib/fixture-software-live/releases/0.1.2/software-live serve --config /etc/fixture-software-live/shadow-endpoint.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
