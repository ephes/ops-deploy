# Managed by ops-library software_live (software_live_impl: rust).
# Runs the pinned Rust release instead of the base unit's Python program;
# removing this file (and daemon-reload) switches back to Python.
[Service]
ExecStart=
ExecStart=/usr/local/lib/fixture-software-live/releases/0.1.2/software-live collect --config /etc/fixture-software-live/policy.json --output /var/lib/fixture-software-live/state.json --cache /var/lib/fixture-software-live/upstream.json --group observer
ExecStartPost=
