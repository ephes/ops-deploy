  "software_live_verify_delay": 2,
  "software_live_collector_wait_retries": 60,
  "software_live_systemd_dir": "/etc/systemd/system",
  "software_live_proc_root": "/proc",
  "software_live_cgroup_root": "/sys/fs/cgroup",
  "software_live_os_release_path": "/etc/os-release",
  "software_live_rust_owner": "root",
  "software_live_rust_group": "root",
  "software_live_rust_version_check_user": "{{ software_live_user }}",
  "_software_live_rust_binary": "{{ software_live_install_dir }}/releases/{{ software_live_rust_version }}/software-live",
  "_software_live_shadow_dir": "{{ software_live_data_dir }}/shadow",
  "_software_live_shadow_config": "{{ software_live_config_dir }}/shadow-endpoint.json"
