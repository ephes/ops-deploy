[Unit]
Description=Read-only software health observation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/fixture-software-live/software_live.py collect --config /etc/fixture-software-live/policy.json --output /var/lib/fixture-software-live/state.json --cache /var/lib/fixture-software-live/upstream.json --group observer
TimeoutStartSec=90
Nice=10
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/fixture-software-live
