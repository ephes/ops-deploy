[Unit]
Description=Paperless-ngx Celery Scheduler
After=network.target postgresql.service redis-server.service paperless.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=archivist
Group=archivist
WorkingDirectory=/srv/archive-app/site/paperless-ngx/src
EnvironmentFile=/srv/archive-app/site/.env
Environment="PATH=/srv/archive-app/site/.venv/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/srv/archive-app/site/.venv/lib/python3.14/site-packages"
Environment="PAPERLESS_NLTK_DIR=/usr/share/nltk_data"

ExecStart=/srv/archive-app/site/.venv/bin/python -m celery --app paperless beat --loglevel INFO

Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
ReadWritePaths=/srv/archive-data /srv/archive-app/site /tmp

# Resource limits
LimitNOFILE=65536
Nice=10

[Install]
WantedBy=multi-user.target
