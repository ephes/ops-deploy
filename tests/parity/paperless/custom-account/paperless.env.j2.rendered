# Paperless-ngx Environment Configuration
# Generated by Ansible - Do not edit manually

# Core settings
PAPERLESS_URL=https://paperless.home.example.org
PAPERLESS_SECRET_KEY=synthetic-key-synthetic-key-synthetic-key-synthetic-key-synthetic-key-
PAPERLESS_ALLOWED_HOSTS=paperless.home.example.org,localhost,127.0.0.1
PAPERLESS_CORS_ALLOWED_HOSTS=https://paperless.home.example.org
PAPERLESS_FORCE_SCRIPT_NAME=
PAPERLESS_STATIC_URL=/static/
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_LANGUAGE=en-us

# Database configuration
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=localhost
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=synthetic-db
PAPERLESS_DB_OPTIONS=sslmode=prefer

# Redis configuration
PAPERLESS_REDIS=redis://localhost:6379/0

# Paths (using external storage)
PAPERLESS_MEDIA_ROOT=/srv/archive-data/media
PAPERLESS_DATA_DIR=/srv/archive-data/data
PAPERLESS_CONSUMPTION_DIR=/srv/archive-data/consume
PAPERLESS_EXPORT_DIR=/srv/archive-data/export
PAPERLESS_STATICDIR=/srv/archive-app/site/staticfiles

# OCR settings
PAPERLESS_OCR_LANGUAGE=eng+deu
PAPERLESS_OCR_MODE=auto
PAPERLESS_OCR_THREADS=2
PAPERLESS_OCR_PAGES=0
PAPERLESS_OCR_IMAGE_DPI=300
PAPERLESS_OCR_USER_ARGS='{}'

# Document processing
PAPERLESS_FILENAME_FORMAT="{{ title }}"
PAPERLESS_FILENAME_DATE_ORDER=YMD
PAPERLESS_CONSUMER_RECURSIVE=True
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=True
PAPERLESS_CONSUMER_IGNORE_PATTERNS='[".DS_Store", "Thumbs.db", "desktop.ini"]'
PAPERLESS_CONSUMER_POLLING=60
PAPERLESS_CONSUMER_POLLING_DELAY=5
PAPERLESS_CONSUMER_POLLING_RETRY_COUNT=3

# Task processing
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=2

# Logging
PAPERLESS_LOGGING_DIR=/srv/archive-app/site/logs
PAPERLESS_LOGROTATE_MAX_SIZE=10485760
PAPERLESS_LOGROTATE_MAX_BACKUPS=5

# Security
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=synthetic-admin
PAPERLESS_ADMIN_MAIL=admin@example.com
PAPERLESS_ENABLE_HTTP_REMOTE_USER=false
PAPERLESS_AUTO_LOGIN_USERNAME=
PAPERLESS_COOKIE_PREFIX=paperless
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.home.example.org
PAPERLESS_TRUSTED_PROXIES=127.0.0.1
PAPERLESS_LOGOUT_REDIRECT_URL=/

# Features
PAPERLESS_ENABLE_UPDATE_CHECK=false
PAPERLESS_DATE_ORDER=DMY
PAPERLESS_CONVERT_MEMORY_LIMIT=256
PAPERLESS_CONVERT_TMPDIR=/srv/archive-data/tmp

# Tika settings (disabled by default)
PAPERLESS_TIKA_ENABLED=false
PAPERLESS_TIKA_ENDPOINT=
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=

# Other settings
# Parsed with PAPERLESS_DATE_ORDER above, so entries must match that order.
PAPERLESS_IGNORE_DATES=01.02.1970,02.03.1980

# Python settings
PYTHONUNBUFFERED=1
DJANGO_SETTINGS_MODULE=paperless.settings

# NLTK data path
NLTK_DATA=/usr/share/nltk_data
PAPERLESS_NLTK_DIR=/usr/share/nltk_data

# Temp directory for processing
PAPERLESS_SCRATCH_DIR=/srv/archive-data/tmp
TMPDIR=/srv/archive-data/tmp
MAGICK_TMPDIR=/srv/archive-data/tmp
