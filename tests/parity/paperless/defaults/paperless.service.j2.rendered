[Unit]
Description=Paperless-ngx Web Server
After=network.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=paperless
Group=paperless
WorkingDirectory=/home/paperless/site/paperless-ngx/src
EnvironmentFile=/home/paperless/site/.env
Environment="PATH=/home/paperless/site/.venv/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/paperless/site/.venv/lib/python3.14/site-packages"
Environment="PAPERLESS_NLTK_DIR=/usr/share/nltk_data"

ExecStart=/home/paperless/site/.venv/bin/gunicorn -c /home/paperless/site/gunicorn.conf.py --bind 0.0.0.0:10030 --workers 2 --worker-class gthread --threads 2 --worker-tmp-dir /dev/shm --timeout 120 paperless.wsgi:application

Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
ReadWritePaths=/mnt/cryptdata/paperless /home/paperless/site

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
