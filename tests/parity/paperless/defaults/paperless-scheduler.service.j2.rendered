[Unit]
Description=Paperless-ngx Celery Scheduler
After=network.target postgresql.service redis-server.service paperless.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=paperless
Group=paperless
WorkingDirectory=/home/paperless/site/paperless-ngx/src
EnvironmentFile=/home/paperless/site/.env
Environment="PATH=/home/paperless/site/.venv/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/paperless/site/.venv/lib/python3.14/site-packages"
Environment="PAPERLESS_NLTK_DIR=/usr/share/nltk_data"

ExecStart=/home/paperless/site/.venv/bin/python -m celery --app paperless beat --loglevel INFO

Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
ReadWritePaths=/mnt/cryptdata/paperless /home/paperless/site /tmp

# Resource limits
LimitNOFILE=65536
Nice=10

[Install]
WantedBy=multi-user.target
