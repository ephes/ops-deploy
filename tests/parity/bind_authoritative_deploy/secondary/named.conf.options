// Managed by Ansible (bind_authoritative_deploy)

acl "trusted" {
    localhost;
    localnets;
};

options {
    directory "/var/cache/bind";

    dnssec-validation auto;
    listen-on-v6 { any; };

    recursion no;
    allow-recursion { none; };
    allow-query-cache { none; };

    allow-query { any; };
    allow-transfer { none; };

};
