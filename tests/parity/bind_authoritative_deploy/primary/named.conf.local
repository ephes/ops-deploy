// Managed by Ansible (bind_authoritative_deploy)

zone "example.org" {
    type master;
    file "/etc/bind/db.example.org";
    allow-transfer { !{ !{ 192.0.2.2; 2001:db8::2; }; any; }; key "xfer-key"; };
    also-notify { 192.0.2.2 key "xfer-key"; 2001:db8::2 key "xfer-key"; };
};

zone "home.example.org" {
    type master;
    file "/var/lib/bind/db.home.example.org";
    update-policy { grant "ddns-key" name home.example.org. A AAAA; grant "ddns-key" name *.home.example.org. A AAAA; grant "acme-key" name _acme-challenge.home.example.org. TXT; };
    allow-transfer { !{ !{ 192.0.2.2; 2001:db8::2; }; any; }; key "xfer-key"; };
    also-notify { 192.0.2.2 key "xfer-key"; 2001:db8::2 key "xfer-key"; };
};

zone "2.0.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.0.2";
};

