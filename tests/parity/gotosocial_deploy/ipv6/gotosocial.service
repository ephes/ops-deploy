# Managed by Ansible (ops-library gotosocial_deploy)
[Unit]
Description=GoToSocial server (example.org)
After=network-online.target
Wants=network-online.target

[Service]
User=gts
Group=gtsgroup
Type=exec
Restart=on-failure
RestartSec=5s
WorkingDirectory=/srv/gts/current
ExecStart=/srv/gts/current/gotosocial --config-path /srv/gts-etc/config.yaml server start
# Cache compiled wazero (ffmpeg/ffprobe) artifacts between restarts.
Environment=GTS_WAZERO_COMPILATION_CACHE=/srv/gts-data/.cache
MemoryMax=512M

# Hardening: upstream example plus a read-only system and a single writable
# data directory. No capabilities: the listener is an unprivileged port.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/gts-data
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
DevicePolicy=closed
LockPersonality=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @privileged
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
