# Managed by Ansible - Mastodon environment

RAILS_ENV=production
NODE_ENV=production

LOCAL_DOMAIN=social.example.org
WEB_DOMAIN=social.example.org

BIND=127.0.0.1
STREAMING_PORT=10041
STREAMING_CLUSTER_NUM=1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mastodon
DB_USER=mastodon
DB_PASS=fixture-secret-sentinel

REDIS_URL=redis://127.0.0.1:6379/0

SECRET_KEY_BASE=fixture-secret-sentinel
OTP_SECRET=fixture-secret-sentinel
VAPID_PRIVATE_KEY=fixture-secret-sentinel
VAPID_PUBLIC_KEY=fixture-secret-sentinel
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=fixture-secret-sentinel
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=fixture-secret-sentinel
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=fixture-secret-sentinel

WEB_CONCURRENCY=2
MAX_THREADS=5
SIDEKIQ_CONCURRENCY=25
DB_POOL=25

SMTP_SERVER=smtp.example.org
SMTP_PORT=587
SMTP_LOGIN=sender@example.org
SMTP_PASSWORD=fixture-secret-sentinel
SMTP_FROM_ADDRESS="Sender <sender@example.org>"
SMTP_DOMAIN=example.org
SMTP_AUTH_METHOD=plain
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_ENABLE_STARTTLS_AUTO=true

S3_ENABLED=false
